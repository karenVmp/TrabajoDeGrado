    //
    ///////////////////////////////////////////////////////////////////////////////////////
     -->

    


    <!-- https://w3id.org/bfpo#AlcoholVariable -->

    <owl:NamedIndividual rdf:about="https://w3id.org/bfpo#AlcoholVariable">
        <rdf:type rdf:resource="https://w3id.org/bfpo#ProcessVariable"/>
        <hasCriticalThresholdMax rdf:datatype="http://www.w3.org/2001/XMLSchema#float">2.0</hasCriticalThresholdMax>
        <hasOptimalRangeMax rdf:datatype="http://www.w3.org/2001/XMLSchema#float">2.0</hasOptimalRangeMax>
        <hasOptimalRangeMin rdf:datatype="http://www.w3.org/2001/XMLSchema#float">0.0</hasOptimalRangeMin>
        <rdfs:comment xml:lang="en">Ethanol concentration produced by yeast activity during coffee fermentation. High alcohol levels may inhibit microbial activity and affect sensory quality. Critical threshold based on Brioschi Junior et al. (2021).</rdfs:comment>
        <rdfs:label xml:lang="en">Alcohol content</rdfs:label>
    </owl:NamedIndividual>
    


    <!-- https://w3id.org/bfpo#BrixVariable -->

    <owl:NamedIndividual rdf:about="https://w3id.org/bfpo#BrixVariable">
        <rdf:type rdf:resource="https://w3id.org/bfpo#ProcessVariable"/>
        <hasCriticalThresholdMin rdf:datatype="http://www.w3.org/2001/XMLSchema#float">8.0</hasCriticalThresholdMin>
        <hasOptimalRangeMax rdf:datatype="http://www.w3.org/2001/XMLSchema#float">16.0</hasOptimalRangeMax>
        <hasOptimalRangeMin rdf:datatype="http://www.w3.org/2001/XMLSchema#float">9.0</hasOptimalRangeMin>
        <rdfs:comment xml:lang="en">Soluble solids content of the fermentation medium expressed in degrees Brix. Indicator of substrate availability for microbial activity. Values based on Ferreira et al. (2023).</rdfs:comment>
        <rdfs:label xml:lang="en">Brix degree</rdfs:label>
    </owl:NamedIndividual>
    


    <!-- https://w3id.org/bfpo#DissolvedOxygenVariable -->

    <owl:NamedIndividual rdf:about="https://w3id.org/bfpo#DissolvedOxygenVariable">
        <rdf:type rdf:resource="https://w3id.org/bfpo#ProcessVariable"/>
        <hasCriticalThresholdMin rdf:datatype="http://www.w3.org/2001/XMLSchema#float">0.1</hasCriticalThresholdMin>
        <hasOptimalRangeMax rdf:datatype="http://www.w3.org/2001/XMLSchema#float">2.0</hasOptimalRangeMax>
        <hasOptimalRangeMin rdf:datatype="http://www.w3.org/2001/XMLSchema#float">0.0</hasOptimalRangeMin>
        <rdfs:comment xml:lang="en">Dissolved oxygen concentration in the fermentation medium. In SIAF and anaerobic fermentation processes, oxygen decreases progressively as microbial  activity consumes it. Values below 0.5 mg/L indicate anaerobiosis. Based on Ferreira et al. (2023).</rdfs:comment>
        <rdfs:label xml:lang="en">Dissolved oxygen</rdfs:label>
    </owl:NamedIndividual>
    


    <!-- https://w3id.org/bfpo#TemperatureVariable -->

    <owl:NamedIndividual rdf:about="https://w3id.org/bfpo#TemperatureVariable">
        <rdf:type rdf:resource="https://w3id.org/bfpo#ProcessVariable"/>
        <hasCriticalThresholdMax rdf:datatype="http://www.w3.org/2001/XMLSchema#float">25.0</hasCriticalThresholdMax>
        <hasOptimalRangeMax rdf:datatype="http://www.w3.org/2001/XMLSchema#float">25.0</hasOptimalRangeMax>
        <hasOptimalRangeMin rdf:datatype="http://www.w3.org/2001/XMLSchema#float">15.0</hasOptimalRangeMin>
        <rdfs:comment xml:lang="en">Temperature of the fermentation medium in the bioreactor. Controls microbial kinetics and enzymatic activity. Optimal range based on Peñuela-Martínez et al. (2023) and 
Cruz-O&apos;Byrne et al. (2020) for controlled temperature coffee fermentation.</rdfs:comment>
        <rdfs:label xml:lang="en">Fermentation temperature</rdfs:label>
    </owl:NamedIndividual>
    


    <!-- https://w3id.org/bfpo#TotalAcidityVariable -->

    <owl:NamedIndividual rdf:about="https://w3id.org/bfpo#TotalAcidityVariable">
        <rdf:type rdf:resource="https://w3id.org/bfpo#ProcessVariable"/>
        <hasCriticalThresholdMax rdf:datatype="http://www.w3.org/2001/XMLSchema#float">1.2</hasCriticalThresholdMax>
        <hasOptimalRangeMax rdf:datatype="http://www.w3.org/2001/XMLSchema#float">1.18</hasOptimalRangeMax>
        <hasOptimalRangeMin rdf:datatype="http://www.w3.org/2001/XMLSchema#float">0.45</hasOptimalRangeMin>
        <rdfs:comment xml:lang="en">Total titratable acidity of the fermentation medium expressed in g/L. Reflects the accumulation of organic acids produced by lactic acid bacteria and yeast during fermentation. Range based on Cruz-O&apos;Byrne et al. (2020)</rdfs:comment>
        <rdfs:label xml:lang="en">Total acidity</rdfs:label>
    </owl:NamedIndividual>
    


    <!-- https://w3id.org/bfpo#pHVariable -->

    <owl:NamedIndividual rdf:about="https://w3id.org/bfpo#pHVariable">
        <rdf:type rdf:resource="https://w3id.org/bfpo#ProcessVariable"/>
        <hasCriticalThresholdMin rdf:datatype="http://www.w3.org/2001/XMLSchema#float">3.6</hasCriticalThresholdMin>
        <hasOptimalRangeMax rdf:datatype="http://www.w3.org/2001/XMLSchema#float">5.5</hasOptimalRangeMax>
        <hasOptimalRangeMin rdf:datatype="http://www.w3.org/2001/XMLSchema#float">4.0</hasOptimalRangeMin>
        <rdfs:comment xml:lang="en">Hydrogen ion concentration in the fermentation medium. Key indicator of microbial activity and fermentation progress in coffee bioreactor fermentation. Optimal range 
and critical threshold based on Cruz-O&apos;Byrne et al. (2020) and Ferreira et al. (2023).</rdfs:comment>
        <rdfs:label xml:lang="en">pH</rdfs:label>
    </owl:NamedIndividual>
    


