        <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#float"/>
        <rdfs:comment xml:lang="en">Maximum critical threshold for a process variable. Values above this threshold indicate a critical condition requiring operational intervention. 
Based on: Peñuela-Martínez et al. (2023), Cruz-O&apos;Byrne et al. (2020).</rdfs:comment>
        <rdfs:isDefinedBy>https://w3id.org/bfpo#</rdfs:isDefinedBy>
        <rdfs:label xml:lang="es">Umbral crítico máximo</rdfs:label>
        <rdfs:label xml:lang="en">has critical threshold maximum</rdfs:label>
    </owl:DatatypeProperty>
    


