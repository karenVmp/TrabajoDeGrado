Based on: Cruz-O&apos;Byrne et al. (2020), Ferreira et al. (2023), 
Peñuela-Martínez et al. (2023).</rdfs:comment>
        <rdfs:isDefinedBy>https://w3id.org/bfpo#</rdfs:isDefinedBy>
        <rdfs:label xml:lang="es">Umbral crítico mínimo</rdfs:label>
        <rdfs:label xml:lang="en">has critical threshold minimum</rdfs:label>
    </owl:DatatypeProperty>
    


