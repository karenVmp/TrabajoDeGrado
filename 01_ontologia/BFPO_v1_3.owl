     -->

    


    <!-- http://www.w3.org/ns/sosa/FeatureOfInterest -->

    <owl:Class rdf:about="http://www.w3.org/ns/sosa/FeatureOfInterest"/>
    


    <!-- http://www.w3.org/ns/sosa/ObservableProperty -->

    <owl:Class rdf:about="http://www.w3.org/ns/sosa/ObservableProperty"/>
    


    <!-- http://www.w3.org/ns/sosa/Observation -->

    <owl:Class rdf:about="http://www.w3.org/ns/sosa/Observation"/>
    


    <!-- https://w3id.org/bfpo#AceticAcid -->

    <owl:Class rdf:about="https://w3id.org/bfpo#AceticAcid">
        <rdfs:subClassOf rdf:resource="https://w3id.org/bfpo#OrganicAcid"/>
        <rdfs:comment xml:lang="es">Ácido etanoico. Indicador de sobrefermentación cuando excede el umbral.</rdfs:comment>
        <rdfs:label xml:lang="en">Acetic acid</rdfs:label>
        <rdfs:label xml:lang="es">Ácido acético</rdfs:label>
        <rdfs:seeAlso rdf:resource="http://purl.obolibrary.org/obo/CHEBI_15366"/>
    </owl:Class>
    


    <!-- https://w3id.org/bfpo#AceticDefect -->

    <owl:Class rdf:about="https://w3id.org/bfpo#AceticDefect">
        <rdfs:subClassOf rdf:resource="https://w3id.org/bfpo#SensoryDefect"/>
        <rdfs:comment xml:lang="es">Sabor a vinagre por producción excesiva de ácido acético durante la fermentación.</rdfs:comment>
        <rdfs:label xml:lang="en">Acetic defect</rdfs:label>
        <rdfs:label xml:lang="es">Defecto acético</rdfs:label>
    </owl:Class>
    


    <!-- https://w3id.org/bfpo#Aftertaste -->

    <owl:Class rdf:about="https://w3id.org/bfpo#Aftertaste">
        <rdfs:subClassOf rdf:resource="https://w3id.org/bfpo#SensoryAttribute"/>
        <rdfs:comment xml:lang="es">Sabor residual percibido después de deglutir el producto evaluado.</rdfs:comment>
        <rdfs:label xml:lang="en">Aftertaste</rdfs:label>
        <rdfs:label xml:lang="es">Retrogusto</rdfs:label>
        <skos:altLabel xml:lang="en">Finish</skos:altLabel>
        <skos:altLabel xml:lang="es">Postgusto</skos:altLabel>
    </owl:Class>
    


    <!-- https://w3id.org/bfpo#Aldehyde -->

    <owl:Class rdf:about="https://w3id.org/bfpo#Aldehyde">
        <rdfs:subClassOf rdf:resource="https://w3id.org/bfpo#VolatileCompound"/>
        <rdfs:comment xml:lang="es">Compuestos con grupo funcional –CHO. Generan aromas florales y frutales en el producto.</rdfs:comment>
        <rdfs:label xml:lang="en">Aldehyde</rdfs:label>
        <rdfs:label xml:lang="es">Aldehído</rdfs:label>
        <rdfs:seeAlso rdf:resource="http://purl.obolibrary.org/obo/CHEBI_17478"/>
    </owl:Class>
    


    <!-- https://w3id.org/bfpo#Alkaloid -->

    <owl:Class rdf:about="https://w3id.org/bfpo#Alkaloid">
        <rdfs:subClassOf rdf:resource="https://w3id.org/bfpo#ChemicalCompound"/>
        <rdfs:comment xml:lang="es">Compuestos nitrogenados bioactivos.</rdfs:comment>
        <rdfs:label xml:lang="es">Alcaloide</rdfs:label>
        <rdfs:label xml:lang="en">Alkaloid</rdfs:label>
        <rdfs:seeAlso rdf:resource="http://purl.obolibrary.org/obo/CHEBI_22315"/>
    </owl:Class>
    


    <!-- https://w3id.org/bfpo#AnaerobicFermentationType -->

    <owl:Class rdf:about="https://w3id.org/bfpo#AnaerobicFermentationType">
        <rdfs:subClassOf rdf:resource="https://w3id.org/bfpo#ClosedSystem"/>
        <rdfs:comment xml:lang="es">Clasificación de fermentaciones sin oxígeno.</rdfs:comment>
        <rdfs:label xml:lang="en">Anaerobic fermentation type</rdfs:label>
        <rdfs:label xml:lang="es">Tipo de fermentación anaeróbica</rdfs:label>
    </owl:Class>
    


    <!-- https://w3id.org/bfpo#Aroma -->

    <owl:Class rdf:about="https://w3id.org/bfpo#Aroma">
        <rdfs:subClassOf rdf:resource="https://w3id.org/bfpo#SensoryAttribute"/>
        <rdfs:comment xml:lang="es">Percepción aromática del producto fermentado evaluada en el protocolo SCA.</rdfs:comment>
        <rdfs:label xml:lang="en">Aroma</rdfs:label>
        <rdfs:label xml:lang="es">Aroma</rdfs:label>
        <rdfs:seeAlso rdf:resource="http://purl.obolibrary.org/obo/PATO_0000058"/>
    </owl:Class>
    


    <!-- https://w3id.org/bfpo#AromaticComplexity -->

    <owl:Class rdf:about="https://w3id.org/bfpo#AromaticComplexity">
        <rdfs:subClassOf rdf:resource="https://w3id.org/bfpo#SensoryAttribute"/>
        <rdfs:comment xml:lang="es">Diversidad de notas aromáticas perceptibles simultáneamente en el producto evaluado.</rdfs:comment>
        <rdfs:label xml:lang="en">Aromatic complexity</rdfs:label>
        <rdfs:label xml:lang="es">Complejidad aromática</rdfs:label>
        <rdfs:seeAlso rdf:resource="http://purl.obolibrary.org/obo/PATO_0001502"/>
    </owl:Class>
    


    <!-- https://w3id.org/bfpo#AromaticNote -->

    <owl:Class rdf:about="https://w3id.org/bfpo#AromaticNote">
        <rdfs:comment xml:lang="es">Clase raíz de todas las notas específicas del perfil organoléptico del producto fermentado según el SCA Flavor Wheel 2016.</rdfs:comment>
        <rdfs:label xml:lang="en">Aromatic note</rdfs:label>
        <rdfs:label xml:lang="es">Nota aromática</rdfs:label>
        <rdfs:seeAlso rdf:resource="http://purl.obolibrary.org/obo/PATO_0000058"/>
    </owl:Class>
    


    <!-- https://w3id.org/bfpo#AromaticProfile -->

    <owl:Class rdf:about="https://w3id.org/bfpo#AromaticProfile">
        <rdfs:subClassOf rdf:resource="https://w3id.org/bfpo#SensoryAttribute"/>
        <rdfs:comment xml:lang="es">Conjunto integrado de aromas percibidos en el producto fermentado.</rdfs:comment>
        <rdfs:label xml:lang="en">Aromatic profile</rdfs:label>
        <rdfs:label xml:lang="es">Perfil aromático</rdfs:label>
    </owl:Class>
    


    <!-- https://w3id.org/bfpo#Bacterium -->

    <owl:Class rdf:about="https://w3id.org/bfpo#Bacterium">
        <rdfs:subClassOf rdf:resource="https://w3id.org/bfpo#Microorganism"/>
        <rdfs:comment xml:lang="es">Microorganismos procarióticos del bioproceso.</rdfs:comment>
        <rdfs:label xml:lang="es">Bacteria</rdfs:label>
        <rdfs:label xml:lang="en">Bacterium</rdfs:label>
        <rdfs:seeAlso rdf:resource="http://purl.obolibrary.org/obo/NCBITaxon_2"/>
    </owl:Class>
    


    <!-- https://w3id.org/bfpo#Balance -->

    <owl:Class rdf:about="https://w3id.org/bfpo#Balance">
        <rdfs:subClassOf rdf:resource="https://w3id.org/bfpo#SensoryAttribute"/>
        <rdfs:comment rdf:resource="https://w3id.org/bfpo"/>
        <rdfs:label xml:lang="en">Balance</rdfs:label>
        <rdfs:label xml:lang="es">Balance</rdfs:label>
    </owl:Class>
    


    <!-- https://w3id.org/bfpo#Bioreactor -->

    <owl:Class rdf:about="https://w3id.org/bfpo#Bioreactor">
        <rdfs:subClassOf rdf:resource="http://www.w3.org/ns/sosa/FeatureOfInterest"/>
        <rdfs:comment xml:lang="es">Instrumento físico donde ocurre el bioproceso de fermentación. Objeto de interés observado por los sensores del sistema.</rdfs:comment>
        <rdfs:label xml:lang="en">Bioreactor</rdfs:label>
        <rdfs:label xml:lang="es">Biorreactor</rdfs:label>
        <rdfs:seeAlso rdf:resource="http://purl.obolibrary.org/obo/PREFER_0000014"/>
        <rdfs:seeAlso rdf:resource="http://www.w3.org/ns/sosa/FeatureOfInterest"/>
        <rdfs:seeAlso rdf:resource="https://saref.etsi.org/core/Device"/>
        <rdfs:seeAlso rdf:resource="https://saref.etsi.org/saref4inma/ProductionEquipment"/>
    </owl:Class>
    


    <!-- https://w3id.org/bfpo#Bitterness -->

    <owl:Class rdf:about="https://w3id.org/bfpo#Bitterness">
        <rdfs:subClassOf rdf:resource="https://w3id.org/bfpo#SensoryAttribute"/>
        <rdfs:comment xml:lang="es">Percepción amarga asociada a compuestos fenólicos y alcaloides del producto.</rdfs:comment>
        <rdfs:label xml:lang="es">Amargor</rdfs:label>
        <rdfs:label xml:lang="en">Bitterness</rdfs:label>
        <rdfs:seeAlso rdf:resource="http://purl.obolibrary.org/obo/PATO_0002474"/>
    </owl:Class>
    


    <!-- https://w3id.org/bfpo#Body -->

    <owl:Class rdf:about="https://w3id.org/bfpo#Body">
        <rdfs:subClassOf rdf:resource="https://w3id.org/bfpo#SensoryAttribute"/>
        <rdfs:comment xml:lang="es">Sensación táctil de peso y textura del producto fermentado en boca.</rdfs:comment>
        <rdfs:label xml:lang="en">Body</rdfs:label>
        <rdfs:label xml:lang="es">Cuerpo</rdfs:label>
        <rdfs:seeAlso rdf:resource="http://purl.obolibrary.org/obo/PATO_0000037"/>
    </owl:Class>
    


    <!-- https://w3id.org/bfpo#CaramelNote -->

    <owl:Class rdf:about="https://w3id.org/bfpo#CaramelNote">
        <rdfs:subClassOf rdf:resource="https://w3id.org/bfpo#AromaticNote"/>
        <rdfs:comment xml:lang="es">Notas de caramelo, miel y panela en el perfil aromático.</rdfs:comment>
        <rdfs:label xml:lang="en">Caramel note</rdfs:label>
        <rdfs:label xml:lang="es">Nota caramelo</rdfs:label>
    </owl:Class>
    


    <!-- https://w3id.org/bfpo#CarbonDioxide -->

    <owl:Class rdf:about="https://w3id.org/bfpo#CarbonDioxide">
        <rdfs:subClassOf rdf:resource="https://w3id.org/bfpo#ChemicalCompound"/>
        <rdfs:comment xml:lang="es">CO2 producido por microorganismos durante la fermentación. Indicador de actividad metabólica.</rdfs:comment>
        <rdfs:label xml:lang="en">Carbon dioxide</rdfs:label>
        <rdfs:label xml:lang="es">Dióxido de carbono (CO2)</rdfs:label>
        <rdfs:seeAlso rdf:resource="http://purl.obolibrary.org/obo/CHEBI_16526"/>
    </owl:Class>
    


    <!-- https://w3id.org/bfpo#CarbonicMaceration -->

    <owl:Class rdf:about="https://w3id.org/bfpo#CarbonicMaceration">
        <rdfs:subClassOf rdf:resource="https://w3id.org/bfpo#AnaerobicFermentationType"/>
        <rdfs:comment xml:lang="es">Fermentación con CO2 exógeno. Término enológico adoptado en café de especialidad.</rdfs:comment>
        <rdfs:label xml:lang="en">Carbonic maceration</rdfs:label>
        <rdfs:label xml:lang="es">Maceración carbónica</rdfs:label>
    </owl:Class>
    


    <!-- https://w3id.org/bfpo#ChemicalCompound -->

    <owl:Class rdf:about="https://w3id.org/bfpo#ChemicalCompound">
        <rdfs:comment xml:lang="es">Clase raíz de todas las sustancias químicas presentes o producidas durante el bioproceso de fermentación.</rdfs:comment>
        <rdfs:label xml:lang="en">Chemical compound</rdfs:label>
        <rdfs:label xml:lang="es">Compuesto químico</rdfs:label>
        <rdfs:seeAlso rdf:resource="http://purl.obolibrary.org/obo/CHEBI_24431"/>
    </owl:Class>
    


    <!-- https://w3id.org/bfpo#ChlorogenicAcid -->

    <owl:Class rdf:about="https://w3id.org/bfpo#ChlorogenicAcid">
        <rdfs:subClassOf rdf:resource="https://w3id.org/bfpo#PhenolicCompound"/>
        <rdfs:comment xml:lang="es">Principales antioxidantes del sustrato. Ésteres del ácido quínico.</rdfs:comment>
        <rdfs:label xml:lang="en">Chlorogenic acid</rdfs:label>
        <rdfs:label xml:lang="es">Ácido clorogénico (CQA)</rdfs:label>
        <rdfs:seeAlso rdf:resource="http://purl.obolibrary.org/obo/CHEBI_16112"/>
        <skos:altLabel xml:lang="en">CQA</skos:altLabel>
    </owl:Class>
    


    <!-- https://w3id.org/bfpo#ChocolateNote -->

    <owl:Class rdf:about="https://w3id.org/bfpo#ChocolateNote">
        <rdfs:subClassOf rdf:resource="https://w3id.org/bfpo#AromaticNote"/>
        <rdfs:comment xml:lang="es">Notas de chocolate y cacao en el perfil aromático.</rdfs:comment>
        <rdfs:label xml:lang="en">Chocolate note</rdfs:label>
        <rdfs:label xml:lang="es">Nota chocolate</rdfs:label>
    </owl:Class>
    


    <!-- https://w3id.org/bfpo#CitricAcid -->

    <owl:Class rdf:about="https://w3id.org/bfpo#CitricAcid">
        <rdfs:subClassOf rdf:resource="https://w3id.org/bfpo#OrganicAcid"/>
        <rdfs:comment xml:lang="es">Ácido 2-hidroxipropano-1,2,3-tricarboxílico. Ácido natural del sustrato fermentativo.</rdfs:comment>
        <rdfs:label xml:lang="en">Citric acid</rdfs:label>
        <rdfs:label xml:lang="es">Ácido cítrico</rdfs:label>
        <rdfs:seeAlso rdf:resource="http://purl.obolibrary.org/obo/CHEBI_30769"/>
    </owl:Class>
    


    <!-- https://w3id.org/bfpo#ClosedSystem -->

    <owl:Class rdf:about="https://w3id.org/bfpo#ClosedSystem">
        <rdfs:subClassOf rdf:resource="https://w3id.org/bfpo#FermentationSystemConfiguration"/>
        <rdfs:comment xml:lang="es">istema sellado sin contacto con el ambiente. Acumula CO2.</rdfs:comment>
        <rdfs:label xml:lang="en">Closed system</rdfs:label>
        <rdfs:label xml:lang="es">Sistema cerrado</rdfs:label>
    </owl:Class>
    


    <!-- https://w3id.org/bfpo#CupClarity -->

    <owl:Class rdf:about="https://w3id.org/bfpo#CupClarity">
        <rdfs:subClassOf rdf:resource="https://w3id.org/bfpo#SensoryAttribute"/>
        <rdfs:comment xml:lang="es">Ausencia de sabores extraños o defectos en el producto evaluado.</rdfs:comment>
        <rdfs:label xml:lang="en">Cup clarity</rdfs:label>
        <rdfs:label xml:lang="es">Limpieza de taza</rdfs:label>
        <skos:altLabel xml:lang="es">Claridad de taza</skos:altLabel>
        <skos:altLabel xml:lang="en">Clean cup</skos:altLabel>
    </owl:Class>
    


    <!-- https://w3id.org/bfpo#Ester -->

    <owl:Class rdf:about="https://w3id.org/bfpo#Ester">
        <rdfs:subClassOf rdf:resource="https://w3id.org/bfpo#VolatileCompound"/>
        <rdfs:comment xml:lang="es">Compuestos de esterificación entre ácidos y alcoholes. Responsables de aromas frutales.</rdfs:comment>
        <rdfs:label xml:lang="en">Ester</rdfs:label>
        <rdfs:label xml:lang="es">Éster</rdfs:label>
        <rdfs:seeAlso rdf:resource="http://purl.obolibrary.org/obo/CHEBI_35701"/>
    </owl:Class>
    


    <!-- https://w3id.org/bfpo#Ethanol -->

    <owl:Class rdf:about="https://w3id.org/bfpo#Ethanol">
        <rdfs:subClassOf rdf:resource="https://w3id.org/bfpo#ChemicalCompound"/>
        <rdfs:comment xml:lang="es">Alcohol etílico C2H5OH. Producto de la fermentación alcohólica de azúcares.</rdfs:comment>
        <rdfs:label xml:lang="es">Etanol</rdfs:label>
        <rdfs:label xml:lang="en">Ethanol</rdfs:label>
        <rdfs:seeAlso rdf:resource="http://purl.obolibrary.org/obo/CHEBI_16236"/>
    </owl:Class>
    


    <!-- https://w3id.org/bfpo#FermentationMediumType -->

    <owl:Class rdf:about="https://w3id.org/bfpo#FermentationMediumType">
        <rdfs:comment xml:lang="es">Clasificación por presencia o ausencia de agua en el medio fermentativo.</rdfs:comment>
        <rdfs:label xml:lang="en">Fermentation medium type</rdfs:label>
        <rdfs:label xml:lang="es">Tipo de medio de fermentación</rdfs:label>
        <rdfs:seeAlso rdf:resource="http://purl.obolibrary.org/obo/PREFER_0000011"/>
    </owl:Class>
    


    <!-- https://w3id.org/bfpo#FermentationSystemConfiguration -->

    <owl:Class rdf:about="https://w3id.org/bfpo#FermentationSystemConfiguration">
        <rdfs:comment xml:lang="es">Tipo de sistema de fermentación por grado de apertura. Determina disponibilidad de oxígeno en el proceso.</rdfs:comment>
        <rdfs:label xml:lang="es">Configuración del sistema</rdfs:label>
        <rdfs:label xml:lang="en">Fermentation system configuration</rdfs:label>
    </owl:Class>
    


    <!-- https://w3id.org/bfpo#FilamentousFungus -->

    <owl:Class rdf:about="https://w3id.org/bfpo#FilamentousFungus">
        <rdfs:subClassOf rdf:resource="https://w3id.org/bfpo#Microorganism"/>
        <rdfs:comment xml:lang="es">Hongos eucarióticos filamentosos distintos de levaduras. Pueden generar defectos sensoriales.</rdfs:comment>
        <rdfs:label xml:lang="en">Filamentous fungus</rdfs:label>
        <rdfs:label xml:lang="es">Hongo filamentoso</rdfs:label>
        <rdfs:seeAlso rdf:resource="http://purl.obolibrary.org/obo/NCBITaxon_4751"/>
    </owl:Class>
    


    <!-- https://w3id.org/bfpo#Flavor -->

    <owl:Class rdf:about="https://w3id.org/bfpo#Flavor">
        <rdfs:subClassOf rdf:resource="https://w3id.org/bfpo#SensoryAttribute"/>
        <rdfs:comment xml:lang="es">Percepción gustativa integrada. Incluye componentes gustativos y retronasal.</rdfs:comment>
        <rdfs:label xml:lang="en">Flavor</rdfs:label>
        <rdfs:label xml:lang="es">Sabor</rdfs:label>
        <rdfs:seeAlso rdf:resource="http://purl.obolibrary.org/obo/PATO_0000043"/>
    </owl:Class>
    


    <!-- https://w3id.org/bfpo#FloralNote -->

    <owl:Class rdf:about="https://w3id.org/bfpo#FloralNote">
        <rdfs:subClassOf rdf:resource="https://w3id.org/bfpo#AromaticNote"/>
        <rdfs:comment xml:lang="es">Notas florales en el perfil aromático. Jazmín, rosa, lavanda.</rdfs:comment>
        <rdfs:label xml:lang="en">Floral note</rdfs:label>
        <rdfs:label xml:lang="es">Nota floral</rdfs:label>
    </owl:Class>
    


    <!-- https://w3id.org/bfpo#Fructose -->

    <owl:Class rdf:about="https://w3id.org/bfpo#Fructose">
        <rdfs:subClassOf rdf:resource="https://w3id.org/bfpo#SimpleSugar"/>
        <rdfs:comment xml:lang="es">Monosacárido consumido por microorganismos fermentadores.</rdfs:comment>
        <rdfs:label xml:lang="es">Fructosa</rdfs:label>
        <rdfs:label xml:lang="en">Fructose</rdfs:label>
        <rdfs:seeAlso rdf:resource="http://purl.obolibrary.org/obo/CHEBI_15824"/>
    </owl:Class>
    


    <!-- https://w3id.org/bfpo#FruityNote -->

    <owl:Class rdf:about="https://w3id.org/bfpo#FruityNote">
        <rdfs:subClassOf rdf:resource="https://w3id.org/bfpo#AromaticNote"/>
        <rdfs:comment xml:lang="es">Notas de frutas en el perfil aromático.</rdfs:comment>
        <rdfs:label xml:lang="en">Fruity note</rdfs:label>
        <rdfs:label xml:lang="es">Nota frutal</rdfs:label>
    </owl:Class>
    


    <!-- https://w3id.org/bfpo#Glucose -->

    <owl:Class rdf:about="https://w3id.org/bfpo#Glucose">
        <rdfs:subClassOf rdf:resource="https://w3id.org/bfpo#SimpleSugar"/>
        <rdfs:comment xml:lang="es">Monosacárido. Principal azúcar consumido por microorganismos durante la fermentación.</rdfs:comment>
        <rdfs:label xml:lang="es">Glucosa</rdfs:label>
        <rdfs:label xml:lang="en">Glucose</rdfs:label>
        <rdfs:seeAlso rdf:resource="http://purl.obolibrary.org/obo/CHEBI_17234"/>
    </owl:Class>
    


    <!-- https://w3id.org/bfpo#HerbalNote -->

    <owl:Class rdf:about="https://w3id.org/bfpo#HerbalNote">
        <rdfs:subClassOf rdf:resource="https://w3id.org/bfpo#AromaticNote"/>
        <rdfs:comment xml:lang="es">Notas herbales de té y plantas en el perfil aromático.</rdfs:comment>
        <rdfs:label xml:lang="en">Herbal note</rdfs:label>
        <rdfs:label xml:lang="es">Nota herbal</rdfs:label>
    </owl:Class>
    


    <!-- https://w3id.org/bfpo#HighQuality -->

    <owl:Class rdf:about="https://w3id.org/bfpo#HighQuality">
        <rdfs:subClassOf rdf:resource="https://w3id.org/bfpo#QualityClassification"/>
        <rdfs:comment xml:lang="es">Puntaje SCA igual o mayor a 85, según el protocolo de catación de la SCA.</rdfs:comment>
        <rdfs:label xml:lang="es">Alta calidad</rdfs:label>
        <rdfs:label xml:lang="en">High quality</rdfs:label>
    </owl:Class>
    


    <!-- https://w3id.org/bfpo#LacticAcid -->

    <owl:Class rdf:about="https://w3id.org/bfpo#LacticAcid">
        <rdfs:subClassOf rdf:resource="https://w3id.org/bfpo#OrganicAcid"/>
        <rdfs:comment xml:lang="es">Principal producto de la fermentación láctica.</rdfs:comment>
        <rdfs:label xml:lang="en">Lactic acid</rdfs:label>
        <rdfs:label xml:lang="es">Ácido láctico</rdfs:label>
        <rdfs:seeAlso rdf:resource="http://purl.obolibrary.org/obo/CHEBI_28358"/>
    </owl:Class>
    


    <!-- https://w3id.org/bfpo#MalicAcid -->

    <owl:Class rdf:about="https://w3id.org/bfpo#MalicAcid">
        <rdfs:subClassOf rdf:resource="https://w3id.org/bfpo#OrganicAcid"/>
        <rdfs:comment xml:lang="es">Ácido hidroxibutanodioico. Componente del perfil de acidez del producto.</rdfs:comment>
        <rdfs:label xml:lang="en">Malic acid</rdfs:label>
        <rdfs:label xml:lang="es">Ácido málico</rdfs:label>
        <rdfs:seeAlso rdf:resource="http://purl.obolibrary.org/obo/CHEBI_6650"/>
    </owl:Class>
    


    <!-- https://w3id.org/bfpo#MediumQuality -->

    <owl:Class rdf:about="https://w3id.org/bfpo#MediumQuality">
        <rdfs:subClassOf rdf:resource="https://w3id.org/bfpo#QualityClassification"/>
        <rdfs:comment xml:lang="es">Puntaje SCA entre 80 y 84,99, según el protocolo de catación de la SCA.</rdfs:comment>
        <rdfs:label xml:lang="es">Calidad media</rdfs:label>
        <rdfs:label xml:lang="en">Medium quality</rdfs:label>
    </owl:Class>
    


    <!-- https://w3id.org/bfpo#Microorganism -->

    <owl:Class rdf:about="https://w3id.org/bfpo#Microorganism">
        <rdfs:comment xml:lang="es">Clase raíz de todos los microorganismos que participan en el bioproceso de fermentación.</rdfs:comment>
        <rdfs:label xml:lang="en">Microorganism</rdfs:label>
        <rdfs:label xml:lang="es">Microorganismo</rdfs:label>
    </owl:Class>
    


    <!-- https://w3id.org/bfpo#NuttyNote -->

    <owl:Class rdf:about="https://w3id.org/bfpo#NuttyNote">
        <rdfs:subClassOf rdf:resource="https://w3id.org/bfpo#AromaticNote"/>
        <rdfs:comment xml:lang="es">Notas de nueces y almendras en el perfil aromático.</rdfs:comment>
        <rdfs:label xml:lang="es">Nota frutos secos</rdfs:label>
        <rdfs:label xml:lang="en">Nutty note</rdfs:label>
    </owl:Class>
    


    <!-- https://w3id.org/bfpo#OpenSystem -->

    <owl:Class rdf:about="https://w3id.org/bfpo#OpenSystem">
        <rdfs:subClassOf rdf:resource="https://w3id.org/bfpo#FermentationSystemConfiguration"/>
        <rdfs:comment xml:lang="es">Sistema de fermentación en contacto con el ambiente. Permite intercambio de O2 y CO2.</rdfs:comment>
        <rdfs:label xml:lang="en">Open system</rdfs:label>
        <rdfs:label xml:lang="es">Sistema abierto</rdfs:label>
    </owl:Class>
    


    <!-- https://w3id.org/bfpo#OrganicAcid -->

    <owl:Class rdf:about="https://w3id.org/bfpo#OrganicAcid">
        <rdfs:subClassOf rdf:resource="https://w3id.org/bfpo#ChemicalCompound"/>
        <rdfs:comment xml:lang="es">Clase padre de los ácidos producidos durante la fermentación.</rdfs:comment>
        <rdfs:label xml:lang="en">Organic acid</rdfs:label>
        <rdfs:label xml:lang="es">Ácido orgánico</rdfs:label>
        <rdfs:seeAlso rdf:resource="http://purl.obolibrary.org/obo/CHEBI_64709"/>
    </owl:Class>
    


    <!-- https://w3id.org/bfpo#OverfermentedDefect -->

    <owl:Class rdf:about="https://w3id.org/bfpo#OverfermentedDefect">
        <rdfs:subClassOf rdf:resource="https://w3id.org/bfpo#SensoryDefect"/>
        <rdfs:comment xml:lang="es">Defecto causado por tiempo o temperatura de fermentación excesivos.</rdfs:comment>
        <rdfs:label xml:lang="es">Defecto de sobrefermentación</rdfs:label>
        <rdfs:label xml:lang="en">Overfermented defect</rdfs:label>
    </owl:Class>
    


    <!-- https://w3id.org/bfpo#OverripeState -->

    <owl:Class rdf:about="https://w3id.org/bfpo#OverripeState">
        <rdfs:subClassOf rdf:resource="https://w3id.org/bfpo#RipenessState"/>
        <rdfs:comment xml:lang="es">Sustrato pasado del punto óptimo. Riesgo de defectos por fermentación previa al proceso.</rdfs:comment>
        <rdfs:label xml:lang="es">Estado sobremaduro</rdfs:label>
        <rdfs:label xml:lang="en">Overripe state</rdfs:label>
    </owl:Class>
    


    <!-- https://w3id.org/bfpo#PhenolicCompound -->

    <owl:Class rdf:about="https://w3id.org/bfpo#PhenolicCompound">
        <rdfs:subClassOf rdf:resource="https://w3id.org/bfpo#ChemicalCompound"/>
        <rdfs:comment xml:lang="es">Antioxidantes y polifenoles del sustrato fermentativo.</rdfs:comment>
        <rdfs:label xml:lang="es">Compuesto fenólico</rdfs:label>
        <rdfs:label xml:lang="en">Phenolic compound</rdfs:label>
        <rdfs:seeAlso rdf:resource="http://purl.obolibrary.org/obo/CHEBI_26195"/>
    </owl:Class>
    


    <!-- https://w3id.org/bfpo#ProcessObservation -->

    <owl:Class rdf:about="https://w3id.org/bfpo#ProcessObservation">
        <rdfs:subClassOf rdf:resource="http://www.w3.org/ns/sosa/Observation"/>
        <rdfs:label xml:lang="es">Observación del proceso</rdfs:label>
        <rdfs:label xml:lang="en">Process observation</rdfs:label>
        <skos:definition xml:lang="en">Record of the fermentation process variables taken at a given time.</skos:definition>
        <skos:definition xml:lang="es">Registro de las variables del proceso de fermentación tomado en un instante determinado.</skos:definition>
    </owl:Class>
    


    <!-- https://w3id.org/bfpo#ProcessVariable -->

    <owl:Class rdf:about="https://w3id.org/bfpo#ProcessVariable">
        <rdfs:subClassOf rdf:resource="http://www.w3.org/ns/sosa/ObservableProperty"/>
        <rdfs:comment xml:lang="en">Measurable variable of the coffee fermentation process in a bioreactor. Each instance 
represents a specific variable with its associated optimal operational ranges and critical thresholds documented in the scientific literature.</rdfs:comment>
        <rdfs:label xml:lang="en">Process Variable</rdfs:label>
        <rdfs:label xml:lang="es">Variable de proceso</rdfs:label>
        <rdfs:seeAlso rdf:resource="http://purl.obolibrary.org/obo/PREFER_0000098"/>
    </owl:Class>
    


    <!-- https://w3id.org/bfpo#ProcessingMethod -->

    <owl:Class rdf:about="https://w3id.org/bfpo#ProcessingMethod">
        <rdfs:comment xml:lang="es">Método de preparación del sustrato antes o durante la fermentación.</rdfs:comment>
        <rdfs:label xml:lang="es">Método de procesamiento</rdfs:label>
        <rdfs:label xml:lang="en">Processing method</rdfs:label>
    </owl:Class>
    


    <!-- https://w3id.org/bfpo#QualityClassification -->

    <owl:Class rdf:about="https://w3id.org/bfpo#QualityClassification">
        <rdfs:subClassOf rdf:resource="https://w3id.org/bfpo#QualityEvaluation"/>
        <rdfs:comment xml:lang="es">Sistema de categorización del producto fermentado por rango de puntaje SCA.</rdfs:comment>
        <rdfs:label xml:lang="es">Clasificación de calidad</rdfs:label>
        <rdfs:label xml:lang="en">Quality classification</rdfs:label>
        <owl:priorVersion rdf:resource="https://w3id.org/bfpo#QualityClassification"/>
    </owl:Class>
    


    <!-- https://w3id.org/bfpo#QualityDescriptor -->

    <owl:Class rdf:about="https://w3id.org/bfpo#QualityDescriptor">
        <rdfs:comment xml:lang="es">Agrupa descriptores cualitativos positivos y defectos sensoriales del producto fermentado evaluado.</rdfs:comment>
        <rdfs:label xml:lang="es">Descriptor de calidad</rdfs:label>
        <rdfs:label xml:lang="en">Quality descriptor</rdfs:label>
        <rdfs:seeAlso rdf:resource="http://purl.obolibrary.org/obo/PATO_0000001"/>
    </owl:Class>
    


    <!-- https://w3id.org/bfpo#QualityEvaluation -->

    <owl:Class rdf:about="https://w3id.org/bfpo#QualityEvaluation">
        <rdfs:comment xml:lang="es">Proceso formal de valoración de calidad del producto fermentado.</rdfs:comment>
        <rdfs:label xml:lang="es">Evaluación de calidad</rdfs:label>
        <rdfs:label xml:lang="en">Quality evaluation</rdfs:label>
    </owl:Class>
    


    <!-- https://w3id.org/bfpo#RipeState -->

    <owl:Class rdf:about="https://w3id.org/bfpo#RipeState">
        <rdfs:subClassOf rdf:resource="https://w3id.org/bfpo#RipenessState"/>
        <rdfs:comment xml:lang="es">Sustrato en punto óptimo de madurez. Mayor contenido de azúcares y aromas precursores.</rdfs:comment>
        <rdfs:label xml:lang="es">Estado maduro</rdfs:label>
        <rdfs:label xml:lang="en">Ripe state</rdfs:label>
        <rdfs:seeAlso rdf:resource="http://purl.obolibrary.org/obo/PATO_0001701"/>
    </owl:Class>
    


    <!-- https://w3id.org/bfpo#RipenessState -->

    <owl:Class rdf:about="https://w3id.org/bfpo#RipenessState">
        <rdfs:comment xml:lang="es">Nivel de madurez del sustrato al inicio del proceso. Determina la composición química inicial.</rdfs:comment>
        <rdfs:label xml:lang="es">Estado de madurez</rdfs:label>
        <rdfs:label xml:lang="en">Ripeness state</rdfs:label>
        <rdfs:seeAlso rdf:resource="http://purl.obolibrary.org/obo/PATO_0000001"/>
    </owl:Class>
    


    <!-- https://w3id.org/bfpo#SCAScore -->

    <owl:Class rdf:about="https://w3id.org/bfpo#SCAScore">
        <rdfs:subClassOf rdf:resource="https://w3id.org/bfpo#QualityEvaluation"/>
        <rdfs:comment xml:lang="es">Puntuación total SCA en escala 0-100.</rdfs:comment>
        <rdfs:label xml:lang="es">Puntaje SCA</rdfs:label>
        <rdfs:label xml:lang="en">SCA score</rdfs:label>
        <skos:altLabel xml:lang="en">Cupping score</skos:altLabel>
        <skos:altLabel xml:lang="es">Score de catación</skos:altLabel>
    </owl:Class>
    


    <!-- https://w3id.org/bfpo#SensoryAcidity -->

    <owl:Class rdf:about="https://w3id.org/bfpo#SensoryAcidity">
        <rdfs:subClassOf rdf:resource="https://w3id.org/bfpo#SensoryAttribute"/>
        <rdfs:comment xml:lang="es">Percepción vibrante de acidez en taza. Distinta del pH que es una medición química.</rdfs:comment>
        <rdfs:label xml:lang="es">Acidez sensorial</rdfs:label>
        <rdfs:label xml:lang="en">Sensory acidity</rdfs:label>
    </owl:Class>
    


    <!-- https://w3id.org/bfpo#SensoryAnalysis -->

    <owl:Class rdf:about="https://w3id.org/bfpo#SensoryAnalysis">
        <rdfs:subClassOf rdf:resource="https://w3id.org/bfpo#QualityEvaluation"/>
        <rdfs:comment xml:lang="es">Evaluación sensorial formal del producto fermentado mediante el protocolo SCA de catación.</rdfs:comment>
        <rdfs:label xml:lang="es">Análisis sensorial</rdfs:label>
        <rdfs:label xml:lang="en">Sensory analysis</rdfs:label>
    </owl:Class>
    


    <!-- https://w3id.org/bfpo#SensoryAttribute -->

    <owl:Class rdf:about="https://w3id.org/bfpo#SensoryAttribute">
        <rdfs:comment xml:lang="es">Clase raíz de todos los atributos evaluados en el análisis sensorial del producto fermentado según el protocolo SCA Cupping 2015.</rdfs:comment>
        <rdfs:label xml:lang="es">Atributo sensorial</rdfs:label>
        <rdfs:label xml:lang="en">Sensory attribute</rdfs:label>
        <rdfs:seeAlso rdf:resource="http://purl.obolibrary.org/obo/PATO_0000001"/>
    </owl:Class>
    


    <!-- https://w3id.org/bfpo#SensoryDefect -->

    <owl:Class rdf:about="https://w3id.org/bfpo#SensoryDefect">
        <rdfs:subClassOf rdf:resource="https://w3id.org/bfpo#QualityDescriptor"/>
        <rdfs:comment xml:lang="es">Sabor indeseable detectable en la evaluación sensorial.</rdfs:comment>
        <rdfs:label xml:lang="es">Defecto sensorial</rdfs:label>
        <rdfs:label xml:lang="en">Sensory defect</rdfs:label>
    </owl:Class>
    


    <!-- https://w3id.org/bfpo#SimpleSugar -->

    <owl:Class rdf:about="https://w3id.org/bfpo#SimpleSugar">
        <rdfs:subClassOf rdf:resource="https://w3id.org/bfpo#ChemicalCompound"/>
        <rdfs:comment xml:lang="es">Azúcares simples del sustrato fermentativo, que agrupan monosacáridos (glucosa, fructosa) y disacáridos (sacarosa). Constituyen los sustratos primarios consumidos por los microorganismos durante la fermentación.</rdfs:comment>
        <rdfs:label xml:lang="es">Azúcar simple</rdfs:label>
        <rdfs:label xml:lang="en">Simple sugar</rdfs:label>
        <rdfs:seeAlso rdf:resource="http://purl.obolibrary.org/obo/CHEBI_16646"/>
    </owl:Class>
    


    <!-- https://w3id.org/bfpo#SolidStateFermentation -->

    <owl:Class rdf:about="https://w3id.org/bfpo#SolidStateFermentation">
        <rdfs:subClassOf rdf:resource="https://w3id.org/bfpo#FermentationMediumType"/>
        <rdfs:comment xml:lang="es">Fermentación sin agua añadida. Menor actividad de agua y proceso más lento.</rdfs:comment>
        <rdfs:label xml:lang="es">Fermentación en estado sólido</rdfs:label>
        <rdfs:label xml:lang="en">Solid state fermentation</rdfs:label>
    </owl:Class>
    


    <!-- https://w3id.org/bfpo#SpicyNote -->

    <owl:Class rdf:about="https://w3id.org/bfpo#SpicyNote">
        <rdfs:subClassOf rdf:resource="https://w3id.org/bfpo#AromaticNote"/>
        <rdfs:comment xml:lang="es">Notas de especias en el perfil aromático. Canela, clavo, pimienta.</rdfs:comment>
        <rdfs:label xml:lang="es">Nota especiada</rdfs:label>
        <rdfs:label xml:lang="en">Spicy note</rdfs:label>
    </owl:Class>
    


    <!-- https://w3id.org/bfpo#StandardAnaerobicFermentation -->

    <owl:Class rdf:about="https://w3id.org/bfpo#StandardAnaerobicFermentation">
        <rdfs:subClassOf rdf:resource="https://w3id.org/bfpo#AnaerobicFermentationType"/>
        <rdfs:comment xml:lang="es">Fermentación en tanques sellados sin O2. Sin modificaciones adicionales al proceso anaeróbico.</rdfs:comment>
        <rdfs:label xml:lang="es">Fermentación anaeróbica estándar</rdfs:label>
        <rdfs:label xml:lang="en">Standard anaerobic fermentation</rdfs:label>
    </owl:Class>
    


    <!-- https://w3id.org/bfpo#StandardQuality -->

    <owl:Class rdf:about="https://w3id.org/bfpo#StandardQuality">
        <rdfs:subClassOf rdf:resource="https://w3id.org/bfpo#QualityClassification"/>
        <rdfs:comment xml:lang="es">Puntaje SCA menor a 80, según el protocolo de catación de la SCA.</rdfs:comment>
        <rdfs:label xml:lang="es">Calidad estándar</rdfs:label>
        <rdfs:label xml:lang="en">Standard quality</rdfs:label>
    </owl:Class>
    


    <!-- https://w3id.org/bfpo#SubmergedFermentation -->

    <owl:Class rdf:about="https://w3id.org/bfpo#SubmergedFermentation">
        <rdfs:subClassOf rdf:resource="https://w3id.org/bfpo#FermentationMediumType"/>
        <rdfs:comment xml:lang="es">ermentación con sustrato bajo agua. Garantiza anaerobiosis total desde el inicio del proceso.</rdfs:comment>
        <rdfs:label xml:lang="es">Fermentación sumergida</rdfs:label>
        <rdfs:label xml:lang="en">Submerged fermentation</rdfs:label>
    </owl:Class>
    


    <!-- https://w3id.org/bfpo#SuccinicAcid -->

    <owl:Class rdf:about="https://w3id.org/bfpo#SuccinicAcid">
        <rdfs:subClassOf rdf:resource="https://w3id.org/bfpo#OrganicAcid"/>
        <rdfs:comment xml:lang="es">Ácido butanodioico. Metabolito producido durante la fermentación.</rdfs:comment>
        <rdfs:label xml:lang="en">Succinic acid</rdfs:label>
        <rdfs:label xml:lang="es">Ácido succínico</rdfs:label>
        <rdfs:seeAlso rdf:resource="http://purl.obolibrary.org/obo/CHEBI_15741"/>
    </owl:Class>
    


    <!-- https://w3id.org/bfpo#Sucrose -->

    <owl:Class rdf:about="https://w3id.org/bfpo#Sucrose">
        <rdfs:subClassOf rdf:resource="https://w3id.org/bfpo#SimpleSugar"/>
        <rdfs:comment xml:lang="es">Disacárido. Precursor de glucosa y fructosa. Principal azúcar de reserva del sustrato.</rdfs:comment>
        <rdfs:label xml:lang="es">Sacarosa</rdfs:label>
        <rdfs:label xml:lang="en">Sucrose</rdfs:label>
        <rdfs:seeAlso rdf:resource="http://purl.obolibrary.org/obo/CHEBI_17992"/>
    </owl:Class>
    


    <!-- https://w3id.org/bfpo#Sweetness -->

    <owl:Class rdf:about="https://w3id.org/bfpo#Sweetness">
        <rdfs:subClassOf rdf:resource="https://w3id.org/bfpo#SensoryAttribute"/>
        <rdfs:comment xml:lang="es">Percepción de dulzura natural del producto. Distinto del contenido de azúcares residuales.</rdfs:comment>
        <rdfs:label xml:lang="es">Dulzor</rdfs:label>
        <rdfs:label xml:lang="en">Sweetness</rdfs:label>
    </owl:Class>
    


    <!-- https://w3id.org/bfpo#Uniformity -->

    <owl:Class rdf:about="https://w3id.org/bfpo#Uniformity">
        <rdfs:subClassOf rdf:resource="https://w3id.org/bfpo#SensoryAttribute"/>
        <rdfs:comment xml:lang="es">Consistencia percibida entre múltiples tazas del mismo lote evaluado.</rdfs:comment>
        <rdfs:label xml:lang="es">Uniformidad</rdfs:label>
        <rdfs:label xml:lang="en">Uniformity</rdfs:label>
    </owl:Class>
    


    <!-- https://w3id.org/bfpo#UnripeState -->

    <owl:Class rdf:about="https://w3id.org/bfpo#UnripeState">
        <rdfs:subClassOf rdf:resource="https://w3id.org/bfpo#RipenessState"/>
        <rdfs:comment xml:lang="es">Sustrato inmaduro. Menor contenido de azúcares y compuestos precursores aromáticos</rdfs:comment>
        <rdfs:label xml:lang="es">Estado verde</rdfs:label>
        <rdfs:label xml:lang="en">Unripe state</rdfs:label>
        <rdfs:seeAlso rdf:resource="http://purl.obolibrary.org/obo/PATO_0001501"/>
    </owl:Class>
    


    <!-- https://w3id.org/bfpo#Variety -->

    <owl:Class rdf:about="https://w3id.org/bfpo#Variety">
        <rdfs:comment xml:lang="es">Variedad botánica del sustrato procesado en la fermentación.</rdfs:comment>
        <rdfs:label xml:lang="es">Variedad del sustrato</rdfs:label>
        <rdfs:label xml:lang="en">Variety</rdfs:label>
    </owl:Class>
    


    <!-- https://w3id.org/bfpo#VolatileCompound -->

    <owl:Class rdf:about="https://w3id.org/bfpo#VolatileCompound">
        <rdfs:subClassOf rdf:resource="https://w3id.org/bfpo#ChemicalCompound"/>
        <rdfs:comment xml:lang="es">Moléculas aromáticas de alta presión de vapor. Determinan el perfil organoléptico del producto fermentado.</rdfs:comment>
        <rdfs:label xml:lang="es">Compuesto volátil (VOC)</rdfs:label>
        <rdfs:label xml:lang="en">Volatile compound</rdfs:label>
        <rdfs:seeAlso rdf:resource="http://purl.obolibrary.org/obo/CHEBI_134179"/>
        <skos:altLabel xml:lang="en">VOCs</skos:altLabel>
    </owl:Class>
    


    <!-- https://w3id.org/bfpo#WinyDefect -->

    <owl:Class rdf:about="https://w3id.org/bfpo#WinyDefect">
        <rdfs:subClassOf rdf:resource="https://w3id.org/bfpo#SensoryDefect"/>
        <rdfs:comment xml:lang="es">Sabor a vino o vinagre por exceso de ácido acético en el producto fermentado.</rdfs:comment>
        <rdfs:label xml:lang="es">Defecto avinado</rdfs:label>
        <rdfs:label xml:lang="en">Winy defect</rdfs:label>
    </owl:Class>
    


    <!-- https://w3id.org/bfpo#WinyNote -->

    <owl:Class rdf:about="https://w3id.org/bfpo#WinyNote">
        <rdfs:subClassOf rdf:resource="https://w3id.org/bfpo#AromaticNote"/>
        <rdfs:comment rdf:resource="https://w3id.org/bfpo#WinyNote"/>
        <rdfs:comment xml:lang="es">Notas fermentadas con carácter vinoso en el perfil aromático.</rdfs:comment>
        <rdfs:label xml:lang="es">Nota vinosa</rdfs:label>
        <rdfs:label xml:lang="en">Winy note</rdfs:label>
    </owl:Class>
    


    <!-- https://w3id.org/bfpo#Yeast -->

    <owl:Class rdf:about="https://w3id.org/bfpo#Yeast">
        <rdfs:subClassOf rdf:resource="https://w3id.org/bfpo#Microorganism"/>
        <rdfs:comment xml:lang="es">Hongos unicelulares fermentadores. Producen etanol, CO2 y compuestos volátiles.</rdfs:comment>
        <rdfs:label xml:lang="es">Levadura</rdfs:label>
        <rdfs:label xml:lang="en">Yeast</rdfs:label>
        <rdfs:seeAlso rdf:resource="http://purl.obolibrary.org/obo/NCBITaxon_147537"/>
    </owl:Class>
    


