    <!-- https://w3id.org/bfpo#measuresVariable -->

    <owl:AnnotationProperty rdf:about="https://w3id.org/bfpo#measuresVariable">
        <rdfs:comment xml:lang="en">Relates a data property used to record an observation to the process variable it measures.</rdfs:comment>
        <rdfs:label xml:lang="en">measures variable</rdfs:label>
    </owl:AnnotationProperty>
    


    <!-- 
    ///////////////////////////////////////////////////////////////////////////////////////
    //
    // Object Properties
    //
    ///////////////////////////////////////////////////////////////////////////////////////
     -->

    


    <!-- http://www.w3.org/ns/sosa/hasFeatureOfInterest -->

    <owl:ObjectProperty rdf:about="http://www.w3.org/ns/sosa/hasFeatureOfInterest"/>
    


    <!-- https://w3id.org/bfpo#conditions -->

    <owl:ObjectProperty rdf:about="https://w3id.org/bfpo#conditions">
        <rdfs:domain rdf:resource="http://www.w3.org/2002/07/owl#Thing"/>
        <rdfs:range rdf:resource="http://www.w3.org/2002/07/owl#Thing"/>
        <rdfs:comment xml:lang="es">Relación de condicionamiento entre dos conceptos del bioproceso.</rdfs:comment>
        <rdfs:label xml:lang="es">Condiciona</rdfs:label>
        <rdfs:label xml:lang="en">Conditions</rdfs:label>
    </owl:ObjectProperty>
    


    <!-- https://w3id.org/bfpo#hasObservation -->

    <owl:ObjectProperty rdf:about="https://w3id.org/bfpo#hasObservation">
        <rdfs:domain rdf:resource="https://w3id.org/bfpo#Bioreactor"/>
        <rdfs:range rdf:resource="https://w3id.org/bfpo#ProcessObservation"/>
        <rdfs:comment xml:lang="es">Vincula el biorreactor con las observaciones registradas por los sensores del sistema.</rdfs:comment>
        <rdfs:label xml:lang="en">Has observation</rdfs:label>
        <rdfs:label xml:lang="es">Tiene observación</rdfs:label>
        <rdfs:seeAlso rdf:resource="http://www.w3.org/ns/sosa/Observation"/>
        <rdfs:seeAlso rdf:resource="https://saref.etsi.org/core/Observation"/>
    </owl:ObjectProperty>
    


    <!-- https://w3id.org/bfpo#hasPart -->

    <owl:ObjectProperty rdf:about="https://w3id.org/bfpo#hasPart">
        <owl:inverseOf rdf:resource="https://w3id.org/bfpo#isPartOf"/>
        <rdfs:domain rdf:resource="http://www.w3.org/2002/07/owl#Thing"/>
        <rdfs:range rdf:resource="http://www.w3.org/2002/07/owl#Thing"/>
        <rdfs:comment xml:lang="es">Indica que un concepto contiene a otro como componente.</rdfs:comment>
        <rdfs:label xml:lang="en">Has part</rdfs:label>
        <rdfs:label xml:lang="es">Tiene como parte</rdfs:label>
        <rdfs:seeAlso rdf:resource="http://www.w3.org/ns/prov#hadMember"/>
    </owl:ObjectProperty>
    


    <!-- https://w3id.org/bfpo#hasQualityClassification -->

    <owl:ObjectProperty rdf:about="https://w3id.org/bfpo#hasQualityClassification">
        <rdfs:domain rdf:resource="https://w3id.org/bfpo#SCAScore"/>
        <rdfs:range rdf:resource="https://w3id.org/bfpo#QualityClassification"/>
        <rdfs:comment xml:lang="es">Vincula el puntaje SCA con su categoría de calidad correspondiente.</rdfs:comment>
        <rdfs:label xml:lang="en">Has quality classification</rdfs:label>
        <rdfs:label xml:lang="es">Tiene clasificación de calidad</rdfs:label>
    </owl:ObjectProperty>
    


    <!-- https://w3id.org/bfpo#hosts -->

    <owl:ObjectProperty rdf:about="https://w3id.org/bfpo#hosts">
        <rdfs:domain rdf:resource="https://w3id.org/bfpo#Bioreactor"/>
        <rdfs:range rdf:resource="https://w3id.org/bfpo#FermentationSystemConfiguration"/>
        <rdfs:comment xml:lang="es">Vincula el biorreactor con la configuración del proceso que aloja.</rdfs:comment>
        <rdfs:label xml:lang="es">Aloja proceso</rdfs:label>
        <rdfs:label xml:lang="en">Hosts</rdfs:label>
    </owl:ObjectProperty>
    


    <!-- https://w3id.org/bfpo#influences -->

    <owl:ObjectProperty rdf:about="https://w3id.org/bfpo#influences">
        <rdfs:domain rdf:resource="http://www.w3.org/2002/07/owl#Thing"/>
        <rdfs:range rdf:resource="http://www.w3.org/2002/07/owl#Thing"/>
        <rdfs:comment xml:lang="es">Relación general de influencia o dependencia documentada entre conceptos del bioproceso. Puede representar una relación directa o una dependencia indirecta inferida; no especifica el sentido de la variación ni demuestra por sí sola causalidad biológica.</rdfs:comment>
        <rdfs:label xml:lang="en">Influences</rdfs:label>
        <rdfs:label xml:lang="es">Influye en</rdfs:label>
    </owl:ObjectProperty>
    


    <!-- https://w3id.org/bfpo#isPartOf -->

    <owl:ObjectProperty rdf:about="https://w3id.org/bfpo#isPartOf">
        <rdfs:domain rdf:resource="http://www.w3.org/2002/07/owl#Thing"/>
        <rdfs:range rdf:resource="http://www.w3.org/2002/07/owl#Thing"/>
        <rdfs:comment xml:lang="es">Relación mereológica. Indica que un concepto es componente de otro.</rdfs:comment>
        <rdfs:label xml:lang="es">Es parte de</rdfs:label>
        <rdfs:label xml:lang="en">Is part of</rdfs:label>
        <rdfs:seeAlso rdf:resource="http://www.w3.org/ns/prov#hadMember"/>
    </owl:ObjectProperty>
    


    <!-- https://w3id.org/bfpo#negativelyInfluences -->

    <owl:ObjectProperty rdf:about="https://w3id.org/bfpo#negativelyInfluences">
        <rdfs:subPropertyOf rdf:resource="https://w3id.org/bfpo#influences"/>
        <rdfs:comment xml:lang="es">Relación de influencia inversa: dentro de las condiciones documentadas, un aumento del sujeto se asocia con una disminución del objeto y una disminución del sujeto con un aumento del objeto. No expresa perjuicio ni deterioro de calidad.</rdfs:comment>
        <rdfs:label xml:lang="es">Influye negativamente en</rdfs:label>
        <rdfs:label xml:lang="en">negatively influences</rdfs:label>
    </owl:ObjectProperty>
    


    <!-- https://w3id.org/bfpo#participatesIn -->

    <owl:ObjectProperty rdf:about="https://w3id.org/bfpo#participatesIn">
        <rdfs:domain rdf:resource="https://w3id.org/bfpo#Microorganism"/>
        <rdfs:range rdf:resource="https://w3id.org/bfpo#Bioreactor"/>
        <rdfs:comment xml:lang="es">Indica que un microorganismo participa activamente en el bioproceso de fermentación.</rdfs:comment>
        <rdfs:label xml:lang="es">Participa en</rdfs:label>
        <rdfs:label xml:lang="en">Participates in</rdfs:label>
    </owl:ObjectProperty>
    


    <!-- https://w3id.org/bfpo#positivelyInfluences -->

    <owl:ObjectProperty rdf:about="https://w3id.org/bfpo#positivelyInfluences">
        <rdfs:subPropertyOf rdf:resource="https://w3id.org/bfpo#influences"/>
        <rdfs:comment xml:lang="es">Relación de influencia directa: dentro de las condiciones documentadas, un aumento del sujeto se asocia con un aumento del objeto y una disminución del sujeto con una disminución del objeto. No expresa beneficio ni calidad favorable.</rdfs:comment>
        <rdfs:label xml:lang="es">Influye positivamente en</rdfs:label>
        <rdfs:label xml:lang="en">positively influences</rdfs:label>
    </owl:ObjectProperty>
    


    <!-- https://w3id.org/bfpo#producedBy -->

    <owl:ObjectProperty rdf:about="https://w3id.org/bfpo#producedBy">
        <rdfs:domain rdf:resource="https://w3id.org/bfpo#ChemicalCompound"/>
        <rdfs:range rdf:resource="https://w3id.org/bfpo#Microorganism"/>
        <rdfs:comment xml:lang="es">Indica qué microorganismo produce un compuesto químico durante el bioproceso.</rdfs:comment>
        <rdfs:label xml:lang="en">Produced by</rdfs:label>
        <rdfs:label xml:lang="es">Producido por</rdfs:label>
    </owl:ObjectProperty>
    


    <!-- https://w3id.org/bfpo#produces -->

    <owl:ObjectProperty rdf:about="https://w3id.org/bfpo#produces">
        <rdfs:subPropertyOf rdf:resource="https://w3id.org/bfpo#influences"/>
        <rdfs:comment xml:lang="en">Relates a biological agent or process to a compound or product it generates during  fermentation. SubProperty of influences.</rdfs:comment>
        <rdfs:label xml:lang="es">Produce</rdfs:label>
        <rdfs:label xml:lang="en">produces</rdfs:label>
    </owl:ObjectProperty>
    


    <!-- https://w3id.org/bfpo#wasGeneratedBy -->

    <owl:ObjectProperty rdf:about="https://w3id.org/bfpo#wasGeneratedBy">
        <rdfs:domain rdf:resource="https://w3id.org/bfpo#ChemicalCompound"/>
        <rdfs:range rdf:resource="https://w3id.org/bfpo#Bioreactor"/>
        <rdfs:comment xml:lang="es">Trazabilidad del compuesto químico. Indica en qué biorreactor fue generado.</rdfs:comment>
        <rdfs:label xml:lang="es">Fue generado por</rdfs:label>
        <rdfs:label xml:lang="en">Was generated by</rdfs:label>
        <rdfs:seeAlso rdf:resource="http://www.w3.org/ns/prov#wasGeneratedBy"/>
    </owl:ObjectProperty>
    


    <!-- 
    ///////////////////////////////////////////////////////////////////////////////////////
    //
    // Data properties
    //
    ///////////////////////////////////////////////////////////////////////////////////////
     -->

    


    <!-- https://w3id.org/bfpo#hasAcidityQuality -->

    <owl:DatatypeProperty rdf:about="https://w3id.org/bfpo#hasAcidityQuality">
        <rdfs:domain rdf:resource="https://w3id.org/bfpo#SensoryAcidity"/>
        <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#string"/>
        <rdfs:comment xml:lang="es">Calidad percibida de la acidez del producto.</rdfs:comment>
        <rdfs:label xml:lang="es">Calidad de acidez</rdfs:label>
        <rdfs:label xml:lang="en">Has acidity quality</rdfs:label>
    </owl:DatatypeProperty>
    


    <!-- https://w3id.org/bfpo#hasAftertasteDuration -->

    <owl:DatatypeProperty rdf:about="https://w3id.org/bfpo#hasAftertasteDuration">
        <rdfs:domain rdf:resource="https://w3id.org/bfpo#Aftertaste"/>
        <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#string"/>
        <rdfs:comment xml:lang="es">Duración del sabor residual post-deglución.</rdfs:comment>
        <rdfs:label xml:lang="es">Duración del retrogusto</rdfs:label>
        <rdfs:label xml:lang="en">Has aftertaste duration</rdfs:label>
    </owl:DatatypeProperty>
    


    <!-- https://w3id.org/bfpo#hasAftertasteQuality -->

    <owl:DatatypeProperty rdf:about="https://w3id.org/bfpo#hasAftertasteQuality">
        <rdfs:domain rdf:resource="https://w3id.org/bfpo#Aftertaste"/>
        <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#string"/>
        <rdfs:comment xml:lang="es">Calidad del retrogusto percibido.</rdfs:comment>
        <rdfs:label xml:lang="es">Calidad del retrogusto</rdfs:label>
        <rdfs:label xml:lang="en">Has aftertaste quality</rdfs:label>
    </owl:DatatypeProperty>
    


    <!-- https://w3id.org/bfpo#hasAgitationFrequency -->

    <owl:DatatypeProperty rdf:about="https://w3id.org/bfpo#hasAgitationFrequency">
        <rdfs:domain rdf:resource="https://w3id.org/bfpo#Bioreactor"/>
        <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#string"/>
        <rdfs:comment xml:lang="es">Descripción de la frecuencia de agitación aplicada al biorreactor.</rdfs:comment>
        <rdfs:label xml:lang="es">Frecuencia de agitación</rdfs:label>
        <rdfs:label xml:lang="en">Has agitation frequency</rdfs:label>
    </owl:DatatypeProperty>
    


    <!-- https://w3id.org/bfpo#hasAgitationSpeed -->

    <owl:DatatypeProperty rdf:about="https://w3id.org/bfpo#hasAgitationSpeed">
        <rdfs:domain rdf:resource="https://w3id.org/bfpo#ProcessObservation"/>
        <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#float"/>
        <rdfs:comment xml:lang="es">Velocidad de agitación mecánica del biorreactor expresada en rpm.</rdfs:comment>
        <rdfs:label xml:lang="en">Has agitation speed</rdfs:label>
        <rdfs:label xml:lang="es">Velocidad de agitación</rdfs:label>
        <rdfs:seeAlso rdf:resource="http://purl.obolibrary.org/obo/PREFER_0000054"/>
        <rdfs:seeAlso rdf:resource="http://www.w3.org/ns/sosa/ObservableProperty"/>
    </owl:DatatypeProperty>
    


    <!-- https://w3id.org/bfpo#hasAgitationType -->

    <owl:DatatypeProperty rdf:about="https://w3id.org/bfpo#hasAgitationType">
        <rdfs:domain rdf:resource="https://w3id.org/bfpo#Bioreactor"/>
        <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#string"/>
        <rdfs:comment xml:lang="es">Patrón de agitación del biorreactor.</rdfs:comment>
        <rdfs:label xml:lang="en">Has agitation type</rdfs:label>
        <rdfs:label xml:lang="es">Tipo de agitación</rdfs:label>
    </owl:DatatypeProperty>
    


    <!-- https://w3id.org/bfpo#hasAirFlow -->

    <owl:DatatypeProperty rdf:about="https://w3id.org/bfpo#hasAirFlow">
        <rdfs:domain rdf:resource="https://w3id.org/bfpo#ProcessObservation"/>
        <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#float"/>
        <rdfs:comment xml:lang="es">Flujo de aire suministrado al biorreactor</rdfs:comment>
        <rdfs:label xml:lang="es">Flujo de aireación</rdfs:label>
        <rdfs:label xml:lang="en">Has air flow</rdfs:label>
        <rdfs:seeAlso rdf:resource="http://purl.obolibrary.org/obo/PREFER_0000055"/>
        <rdfs:seeAlso rdf:resource="http://www.w3.org/ns/sosa/ObservableProperty"/>
    </owl:DatatypeProperty>
    


    <!-- https://w3id.org/bfpo#hasAltitude -->

    <owl:DatatypeProperty rdf:about="https://w3id.org/bfpo#hasAltitude">
        <rdfs:domain rdf:resource="https://w3id.org/bfpo#Bioreactor"/>
        <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#float"/>
        <rdfs:comment xml:lang="es">Altura sobre el nivel del mar donde se ubica el biorreactor. En metros.</rdfs:comment>
        <rdfs:label xml:lang="es">Altitud</rdfs:label>
        <rdfs:label xml:lang="en">Has altitude</rdfs:label>
        <rdfs:seeAlso rdf:resource="http://qudt.org/vocab/quantitykind/Altitude"/>
    </owl:DatatypeProperty>
    


    <!-- https://w3id.org/bfpo#hasAmbientHumidity -->

    <owl:DatatypeProperty rdf:about="https://w3id.org/bfpo#hasAmbientHumidity">
        <rdfs:domain rdf:resource="https://w3id.org/bfpo#ProcessObservation"/>
        <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#float"/>
        <rdfs:comment xml:lang="es">Humedad relativa del ambiente externo al biorreactor expresada en porcentaje.</rdfs:comment>
        <rdfs:label xml:lang="en">Has ambient humidity</rdfs:label>
        <rdfs:label xml:lang="es">Humedad del ambiente</rdfs:label>
        <rdfs:seeAlso rdf:resource="http://www.w3.org/ns/sosa/ObservableProperty"/>
    </owl:DatatypeProperty>
    


    <!-- https://w3id.org/bfpo#hasAmbientTemperature -->

    <owl:DatatypeProperty rdf:about="https://w3id.org/bfpo#hasAmbientTemperature">
        <rdfs:domain rdf:resource="https://w3id.org/bfpo#ProcessObservation"/>
        <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#float"/>
        <rdfs:comment xml:lang="es">Temperatura del entorno externo al biorreactor.</rdfs:comment>
        <rdfs:label xml:lang="en">Has ambient temperature</rdfs:label>
        <rdfs:label xml:lang="es">Temperatura ambiente</rdfs:label>
        <rdfs:seeAlso rdf:resource="http://www.w3.org/ns/sosa/ObservableProperty"/>
    </owl:DatatypeProperty>
    


    <!-- https://w3id.org/bfpo#hasAnaerobicThreshold -->

    <owl:DatatypeProperty rdf:about="https://w3id.org/bfpo#hasAnaerobicThreshold">
        <rdfs:domain rdf:resource="https://w3id.org/bfpo#Bioreactor"/>
        <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#float"/>
        <rdfs:comment xml:lang="es">Valor de oxígeno disuelto por debajo del cual se considera condición anaeróbica.</rdfs:comment>
        <rdfs:label xml:lang="en">Has anaerobic threshold</rdfs:label>
        <rdfs:label xml:lang="es">Umbral anaeróbico</rdfs:label>
    </owl:DatatypeProperty>
    


    <!-- https://w3id.org/bfpo#hasAromaticIntensity -->

    <owl:DatatypeProperty rdf:about="https://w3id.org/bfpo#hasAromaticIntensity">
        <rdfs:domain rdf:resource="https://w3id.org/bfpo#AromaticProfile"/>
        <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#string"/>
        <rdfs:comment xml:lang="es">Fuerza del perfil aromático percibido en el producto.</rdfs:comment>
        <rdfs:label xml:lang="en">Has aromatic intensity</rdfs:label>
        <rdfs:label xml:lang="es">Intensidad aromática</rdfs:label>
    </owl:DatatypeProperty>
    


    <!-- https://w3id.org/bfpo#hasBalanceQuality -->

    <owl:DatatypeProperty rdf:about="https://w3id.org/bfpo#hasBalanceQuality">
        <rdfs:domain rdf:resource="https://w3id.org/bfpo#Balance"/>
        <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#string"/>
        <rdfs:comment xml:lang="es">Calidad de la armonía entre los atributos sensoriales.</rdfs:comment>
        <rdfs:label xml:lang="es">Calidad del balance</rdfs:label>
        <rdfs:label xml:lang="en">Has balance quality</rdfs:label>
    </owl:DatatypeProperty>
    


    <!-- https://w3id.org/bfpo#hasBitternessQuality -->

    <owl:DatatypeProperty rdf:about="https://w3id.org/bfpo#hasBitternessQuality">
        <rdfs:domain rdf:resource="https://w3id.org/bfpo#Bitterness"/>
        <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#string"/>
        <rdfs:comment xml:lang="es">Calidad del amargor percibido en el producto.</rdfs:comment>
        <rdfs:label xml:lang="es">Calidad del amargor</rdfs:label>
        <rdfs:label xml:lang="en">Has bitterness quality</rdfs:label>
    </owl:DatatypeProperty>
    


    <!-- https://w3id.org/bfpo#hasBrixDegree -->

    <owl:DatatypeProperty rdf:about="https://w3id.org/bfpo#hasBrixDegree">
