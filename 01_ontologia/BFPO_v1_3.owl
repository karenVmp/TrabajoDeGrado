        <rdfs:seeAlso rdf:resource="http://www.w3.org/ns/sosa/ObservableProperty"/>
    </owl:DatatypeProperty>
    


    <!-- https://w3id.org/bfpo#hasOptimalTemperature -->

    <owl:DatatypeProperty rdf:about="https://w3id.org/bfpo#hasOptimalTemperature">
        <rdfs:domain rdf:resource="https://w3id.org/bfpo#Microorganism"/>
        <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#float"/>
        <rdfs:comment xml:lang="es">Temperatura óptima de crecimiento de la especie microbiológica.</rdfs:comment>
        <rdfs:label xml:lang="en">Has optimal temperature</rdfs:label>
        <rdfs:label xml:lang="es">Temperatura óptima</rdfs:label>
    </owl:DatatypeProperty>
    


    <!-- https://w3id.org/bfpo#hasOrganicAcidProfile -->

    <owl:DatatypeProperty rdf:about="https://w3id.org/bfpo#hasOrganicAcidProfile">
        <rdfs:domain rdf:resource="https://w3id.org/bfpo#Bioreactor"/>
        <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#string"/>
        <rdfs:comment xml:lang="es">Análisis completo de ácidos orgánicos presentes en el producto final de la fermentación.</rdfs:comment>
        <rdfs:label xml:lang="en">Has organic acid profile</rdfs:label>
        <rdfs:label xml:lang="es">Perfil de ácidos orgánicos</rdfs:label>
        <rdfs:seeAlso rdf:resource="http://purl.obolibrary.org/obo/PREFER_0000074"/>
    </owl:DatatypeProperty>
    


    <!-- https://w3id.org/bfpo#hasOxygenTolerance -->

    <owl:DatatypeProperty rdf:about="https://w3id.org/bfpo#hasOxygenTolerance">
        <rdfs:domain rdf:resource="https://w3id.org/bfpo#Bacterium"/>
        <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#string"/>
        <rdfs:comment xml:lang="es">Requerimiento de oxígeno para el crecimiento.</rdfs:comment>
        <rdfs:label xml:lang="en">Has oxygen tolerance</rdfs:label>
        <rdfs:label xml:lang="es">Tolerancia al oxígeno</rdfs:label>
    </owl:DatatypeProperty>
    


    <!-- https://w3id.org/bfpo#hasPH -->

    <owl:DatatypeProperty rdf:about="https://w3id.org/bfpo#hasPH">
        <rdfs:domain rdf:resource="https://w3id.org/bfpo#ProcessObservation"/>
        <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#float"/>
        <rdfs:comment xml:lang="es">Potencial de hidrógeno del medio fermentativo.</rdfs:comment>
        <rdfs:label xml:lang="en">Has pH</rdfs:label>
        <rdfs:label xml:lang="es">pH</rdfs:label>
        <rdfs:seeAlso rdf:resource="http://purl.obolibrary.org/obo/PREFER_0000040"/>
        <rdfs:seeAlso rdf:resource="http://www.w3.org/ns/sosa/ObservableProperty"/>
        <measuresVariable rdf:resource="https://w3id.org/bfpo#pH"/>
    </owl:DatatypeProperty>
    


    <!-- https://w3id.org/bfpo#hasPerceivedIntensity -->

    <owl:DatatypeProperty rdf:about="https://w3id.org/bfpo#hasPerceivedIntensity">
        <rdfs:domain rdf:resource="https://w3id.org/bfpo#SensoryAttribute"/>
        <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#string"/>
        <rdfs:comment xml:lang="es">Intensidad de percepción de un atributo sensorial.</rdfs:comment>
        <rdfs:label xml:lang="en">Has perceived intensity</rdfs:label>
        <rdfs:label xml:lang="es">Intensidad percibida</rdfs:label>
    </owl:DatatypeProperty>
    


    <!-- https://w3id.org/bfpo#hasPerceivedWeight -->

    <owl:DatatypeProperty rdf:about="https://w3id.org/bfpo#hasPerceivedWeight">
        <rdfs:domain rdf:resource="https://w3id.org/bfpo#Body"/>
        <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#string"/>
        <rdfs:comment xml:lang="es">Sensación de peso del producto en boca.</rdfs:comment>
        <rdfs:label xml:lang="en">Has perceived weight</rdfs:label>
        <rdfs:label xml:lang="es">Peso percibido</rdfs:label>
    </owl:DatatypeProperty>
    


    <!-- https://w3id.org/bfpo#hasProbableCause -->

    <owl:DatatypeProperty rdf:about="https://w3id.org/bfpo#hasProbableCause">
        <rdfs:domain rdf:resource="https://w3id.org/bfpo#SensoryDefect"/>
        <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#string"/>
        <rdfs:comment xml:lang="es">Causa probable del defecto sensorial identificado en la evaluación.</rdfs:comment>
        <rdfs:label xml:lang="es">Causa probable</rdfs:label>
        <rdfs:label xml:lang="en">Has probable cause</rdfs:label>
    </owl:DatatypeProperty>
    


    <!-- https://w3id.org/bfpo#hasRedoxPotential -->

    <owl:DatatypeProperty rdf:about="https://w3id.org/bfpo#hasRedoxPotential">
        <rdfs:domain rdf:resource="https://w3id.org/bfpo#ProcessObservation"/>
        <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#float"/>
        <rdfs:comment xml:lang="es">Potencial de oxidorreducción del medio</rdfs:comment>
        <rdfs:label xml:lang="en">Has redox potential</rdfs:label>
        <rdfs:label xml:lang="es">Potencial redox (ORP)</rdfs:label>
        <rdfs:seeAlso rdf:resource="http://www.w3.org/ns/sosa/ObservableProperty"/>
        <skos:altLabel xml:lang="en">ORP</skos:altLabel>
    </owl:DatatypeProperty>
    


    <!-- https://w3id.org/bfpo#hasResidualSugarContent -->

    <owl:DatatypeProperty rdf:about="https://w3id.org/bfpo#hasResidualSugarContent">
        <rdfs:domain rdf:resource="https://w3id.org/bfpo#Bioreactor"/>
        <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#float"/>
        <rdfs:comment xml:lang="es">Azúcares no consumidos por los microorganismos al finalizar la fermentación</rdfs:comment>
        <rdfs:label xml:lang="es">Contenido de azúcares residuales</rdfs:label>
        <rdfs:label xml:lang="en">Has residual sugar content</rdfs:label>
        <rdfs:seeAlso rdf:resource="http://purl.obolibrary.org/obo/PREFER_0000111"/>
    </owl:DatatypeProperty>
    


    <!-- https://w3id.org/bfpo#hasRipenessLevel -->

    <owl:DatatypeProperty rdf:about="https://w3id.org/bfpo#hasRipenessLevel">
        <rdfs:domain rdf:resource="https://w3id.org/bfpo#RipenessState"/>
        <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#string"/>
        <rdfs:comment xml:lang="es">Estado de maduración del sustrato al inicio del proceso.</rdfs:comment>
        <rdfs:label xml:lang="en">Has ripeness level</rdfs:label>
        <rdfs:label xml:lang="es">Nivel de madurez</rdfs:label>
    </owl:DatatypeProperty>
    


    <!-- https://w3id.org/bfpo#hasSCAAttributeScore -->

    <owl:DatatypeProperty rdf:about="https://w3id.org/bfpo#hasSCAAttributeScore">
        <rdfs:domain rdf:resource="https://w3id.org/bfpo#SensoryAttribute"/>
        <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#float"/>
        <rdfs:comment xml:lang="es">Puntaje individual de cada atributo sensorial en escala 0-10.</rdfs:comment>
        <rdfs:label xml:lang="en">Has SCA attribute score</rdfs:label>
        <rdfs:label xml:lang="es">Puntaje SCA por atributo</rdfs:label>
    </owl:DatatypeProperty>
    


    <!-- https://w3id.org/bfpo#hasSCAScore -->

    <owl:DatatypeProperty rdf:about="https://w3id.org/bfpo#hasSCAScore">
        <rdfs:domain rdf:resource="https://w3id.org/bfpo#SCAScore"/>
        <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#float"/>
        <rdfs:comment xml:lang="es">Puntuación total del protocolo SCA en escala 0-100.</rdfs:comment>
        <rdfs:label xml:lang="en">Has SCA score</rdfs:label>
        <rdfs:label xml:lang="es">Puntaje SCA total</rdfs:label>
    </owl:DatatypeProperty>
    


    <!-- https://w3id.org/bfpo#hasSanitaryLevel -->

    <owl:DatatypeProperty rdf:about="https://w3id.org/bfpo#hasSanitaryLevel">
        <rdfs:domain rdf:resource="https://w3id.org/bfpo#Bioreactor"/>
        <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#string"/>
        <rdfs:comment xml:lang="es">Estado sanitario inicial del sustrato.</rdfs:comment>
        <rdfs:label xml:lang="en">Has sanitary level</rdfs:label>
        <rdfs:label xml:lang="es">Nivel sanitario inicial</rdfs:label>
    </owl:DatatypeProperty>
    


    <!-- https://w3id.org/bfpo#hasScientificName -->

    <owl:DatatypeProperty rdf:about="https://w3id.org/bfpo#hasScientificName">
        <rdfs:domain rdf:resource="https://w3id.org/bfpo#Microorganism"/>
        <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#string"/>
        <rdfs:comment xml:lang="es">Nombre científico binomial de la especie microbiológica según nomenclatura ICBN/ICNB.</rdfs:comment>
        <rdfs:label xml:lang="en">Has scientific name</rdfs:label>
        <rdfs:label xml:lang="es">Nombre científico</rdfs:label>
    </owl:DatatypeProperty>
    


    <!-- https://w3id.org/bfpo#hasShannonIndex -->

    <owl:DatatypeProperty rdf:about="https://w3id.org/bfpo#hasShannonIndex">
        <rdfs:domain rdf:resource="https://w3id.org/bfpo#Bioreactor"/>
        <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#float"/>
        <rdfs:comment xml:lang="es">Índice de diversidad de especies microbianas presentes en el bioproceso.</rdfs:comment>
        <rdfs:label xml:lang="en">Has Shannon index</rdfs:label>
        <rdfs:label xml:lang="es">Índice de diversidad Shannon</rdfs:label>
    </owl:DatatypeProperty>
    


    <!-- https://w3id.org/bfpo#hasSpecies -->

    <owl:DatatypeProperty rdf:about="https://w3id.org/bfpo#hasSpecies">
        <rdfs:domain rdf:resource="https://w3id.org/bfpo#Variety"/>
        <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#string"/>
        <rdfs:comment>Especie botánica de la variedad del sustrato.</rdfs:comment>
        <rdfs:label xml:lang="es">Especie</rdfs:label>
        <rdfs:label xml:lang="en">Has species</rdfs:label>
    </owl:DatatypeProperty>
    


    <!-- https://w3id.org/bfpo#hasSpiceType -->

    <owl:DatatypeProperty rdf:about="https://w3id.org/bfpo#hasSpiceType">
        <rdfs:domain rdf:resource="https://w3id.org/bfpo#SpicyNote"/>
        <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#string"/>
        <rdfs:comment xml:lang="es">Subcategoría de la nota especiada.</rdfs:comment>
        <rdfs:label xml:lang="en">Has spice type</rdfs:label>
        <rdfs:label xml:lang="es">Tipo de nota especiada</rdfs:label>
    </owl:DatatypeProperty>
    


    <!-- https://w3id.org/bfpo#hasSubstrateHumidity -->

    <owl:DatatypeProperty rdf:about="https://w3id.org/bfpo#hasSubstrateHumidity">
        <rdfs:domain rdf:resource="https://w3id.org/bfpo#ProcessObservation"/>
        <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#float"/>
        <rdfs:comment xml:lang="es">Contenido de agua en el sustrato durante la fermentación expresado en porcentaje.</rdfs:comment>
        <rdfs:label xml:lang="en">Has substrate humidity</rdfs:label>
        <rdfs:label xml:lang="es">Humedad del sustrato</rdfs:label>
        <rdfs:seeAlso rdf:resource="http://www.w3.org/ns/sosa/ObservableProperty"/>
    </owl:DatatypeProperty>
    


    <!-- https://w3id.org/bfpo#hasSubstrateVolume -->

    <owl:DatatypeProperty rdf:about="https://w3id.org/bfpo#hasSubstrateVolume">
        <rdfs:comment xml:lang="es">Volumen en litros del sustrato fermentativo en el biorreactor.</rdfs:comment>
        <rdfs:label xml:lang="en">Has substrate volume</rdfs:label>
        <rdfs:label xml:lang="es">Volumen del sustrato</rdfs:label>
        <rdfs:seeAlso rdf:resource="http://www.w3.org/ns/sosa/ObservableProperty"/>
    </owl:DatatypeProperty>
    


    <!-- https://w3id.org/bfpo#hasTexture -->

    <owl:DatatypeProperty rdf:about="https://w3id.org/bfpo#hasTexture">
        <rdfs:domain rdf:resource="https://w3id.org/bfpo#Body"/>
        <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#string"/>
        <rdfs:comment xml:lang="es">Textura percibida del producto en boca.</rdfs:comment>
        <rdfs:label xml:lang="en">Has texture</rdfs:label>
        <rdfs:label xml:lang="es">Textura</rdfs:label>
    </owl:DatatypeProperty>
    


    <!-- https://w3id.org/bfpo#hasTotalMicrobialPopulation -->

    <owl:DatatypeProperty rdf:about="https://w3id.org/bfpo#hasTotalMicrobialPopulation">
        <rdfs:domain rdf:resource="https://w3id.org/bfpo#ProcessObservation"/>
        <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#float"/>
        <rdfs:comment xml:lang="es">Suma de UFC/mL de todos los microorganismos presentes en el proceso.</rdfs:comment>
        <rdfs:label xml:lang="en">Has total microbial population</rdfs:label>
        <rdfs:label xml:lang="es">Población microbiana total</rdfs:label>
        <rdfs:seeAlso rdf:resource="http://www.w3.org/ns/sosa/ObservableProperty"/>
    </owl:DatatypeProperty>
    


    <!-- https://w3id.org/bfpo#hasTotalTritrableAcidity -->

    <owl:DatatypeProperty rdf:about="https://w3id.org/bfpo#hasTotalTritrableAcidity">
        <rdfs:domain rdf:resource="https://w3id.org/bfpo#Bioreactor"/>
        <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#float"/>
        <rdfs:comment xml:lang="es">Acidez acumulada en el producto fermentado.</rdfs:comment>
        <rdfs:label xml:lang="es">Acidez total y titulable</rdfs:label>
        <rdfs:label xml:lang="en">Has total titratable acidity</rdfs:label>
    </owl:DatatypeProperty>
    


    <!-- https://w3id.org/bfpo#hasVarietyName -->

    <owl:DatatypeProperty rdf:about="https://w3id.org/bfpo#hasVarietyName">
        <rdfs:domain rdf:resource="https://w3id.org/bfpo#Variety"/>
        <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#string"/>
        <rdfs:comment xml:lang="es">Nombre de la variedad botánica del sustrato procesado en la fermentación.</rdfs:comment>
        <rdfs:label xml:lang="en">Has variety name</rdfs:label>
        <rdfs:label xml:lang="es">Nombre de variedad</rdfs:label>
    </owl:DatatypeProperty>
    


    <!-- https://w3id.org/bfpo#meetsCriteria -->

    <owl:DatatypeProperty rdf:about="https://w3id.org/bfpo#meetsCriteria">
        <rdfs:domain rdf:resource="https://w3id.org/bfpo#HighQuality"/>
        <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#boolean"/>
        <rdfs:comment xml:lang="es">Indica si el producto cumple el criterio de alta calidad según el protocolo SCA.</rdfs:comment>
        <rdfs:label xml:lang="es">Cumple criterio</rdfs:label>
        <rdfs:label xml:lang="en">Meets criteria</rdfs:label>
    </owl:DatatypeProperty>
    


