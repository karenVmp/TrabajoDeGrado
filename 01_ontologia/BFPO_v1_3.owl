<?xml version="1.0"?>
<rdf:RDF xmlns="https://w3id.org/bfpo#"
     xml:base="https://w3id.org/bfpo"
     xmlns:dc="http://purl.org/dc/elements/1.1/"
     xmlns:mod="http://www.isibang.ac.in/ns/mod#"
     xmlns:owl="http://www.w3.org/2002/07/owl#"
     xmlns:rdf="http://www.w3.org/1999/02/22-rdf-syntax-ns#"
     xmlns:xml="http://www.w3.org/XML/1998/namespace"
     xmlns:xsd="http://www.w3.org/2001/XMLSchema#"
     xmlns:bfpo="https://w3id.org/bfpo#"
     xmlns:rdfs="http://www.w3.org/2000/01/rdf-schema#"
     xmlns:skos="http://www.w3.org/2004/02/skos/core#">
    <owl:Ontology rdf:about="https://w3id.org/bfpo">
        <owl:versionIRI rdf:resource="https://w3id.org/bfpo/1.3"/>
        <dc:creator>Karen Viviana Muñoz Portilla</dc:creator>
        <dc:date>2026-11</dc:date>
        <dc:description xml:lang="es">Ontología de dominio que formaliza el conocimiento del bioproceso de fermentación en biorreactor. Desarrollada como parte del trabajo de grado en la Universidad del Cauca.</dc:description>
        <dc:language>es</dc:language>
        <dc:publisher>Universidad del Cauca</dc:publisher>
        <dc:rights>CC BY 4.0</dc:rights>
        <dc:title>Bioreactor Fermentation Process Ontology</dc:title>
        <mod:acronym>BFPO</mod:acronym>
        <mod:formalityLevel>OWL 2 DL</mod:formalityLevel>
        <mod:naturalLanguage>es (etiquetas) , en (identificadores técnicos)</mod:naturalLanguage>
        <mod:noOfClasses>75</mod:noOfClasses>
        <mod:noOfProperties rdf:datatype="http://www.w3.org/2001/XMLSchema#integer">87</mod:noOfProperties>
        <mod:ontologyType>Domain Ontology</mod:ontologyType>
        <mod:status>stable</mod:status>
        <rdfs:comment xml:lang="es">Bioreactor Fermentation Process Ontology - Ontología del bioproceso de fermentación en biorreactor</rdfs:comment>
        <owl:priorVersion rdf:resource="https://w3id.org/bfpo/1.2"/>
        <owl:versionInfo>1.3</owl:versionInfo>
        <skos:changeNote xml:lang="es">Versión 1.3: Nueva clase ProcessObservation, subclase de sosa:Observation; ProcessVariable pasa a ser subclase de sosa:ObservableProperty (antes de Bioreactor); Bioreactor, subclase de sosa:FeatureOfInterest; Dominio de 14 propiedades de medición: ProcessObservation (antes Bioreactor); Dominio de rangos óptimos y umbrales críticos: ProcessVariable; Axioma AllDisjointClasses entre 14 clases principales.</skos:changeNote>
    </owl:Ontology>
    


