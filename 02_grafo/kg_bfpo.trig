<http://w3id.org/bfpo/ontology> {
  :Aldehyde rdfs:comment "Compuestos con grupo funcional –CHO. Generan aromas florales y frutales en el producto."@es;
    rdfs:label "Aldehyde"@en, "Aldehído"@es;
    rdfs:seeAlso obo:CHEBI_17478 .
  
  :VolatileCompound rdfs:comment "Moléculas aromáticas de alta presión de vapor. Determinan el perfil organoléptico del producto fermentado."@es;
    rdfs:label "Volatile compound"@en, "Compuesto volátil (VOC)"@es;
    rdfs:seeAlso obo:CHEBI_134179 .
  
  :Alkaloid rdfs:comment "Compuestos nitrogenados bioactivos."@es;
    rdfs:label "Alkaloid"@en, "Alcaloide"@es;
    rdfs:seeAlso obo:CHEBI_22315 .
  
  :ChemicalCompound rdfs:comment "Clase raíz de todas las sustancias químicas presentes o producidas durante el bioproceso de fermentación."@es;
    rdfs:label "Chemical compound"@en, "Compuesto químico"@es;
    rdfs:seeAlso obo:CHEBI_24431 .
  
  :CarbonDioxide rdfs:comment "CO2 producido por microorganismos durante la fermentación. Indicador de actividad metabólica."@es;
    rdfs:label "Carbon dioxide"@en, "Dióxido de carbono (CO2)"@es;
    rdfs:seeAlso obo:CHEBI_16526 .
  
  :ChlorogenicAcid rdfs:comment "Principales antioxidantes del sustrato. Ésteres del ácido quínico."@es;
    rdfs:label "Chlorogenic acid"@en, "Ácido clorogénico (CQA)"@es;
    rdfs:seeAlso obo:CHEBI_16112 .
  
  :PhenolicCompound rdfs:comment "Antioxidantes y polifenoles del sustrato fermentativo."@es;
    rdfs:label "Phenolic compound"@en, "Compuesto fenólico"@es;
    rdfs:seeAlso obo:CHEBI_26195 .
  
  :CitricAcid rdfs:comment "Ácido 2-hidroxipropano-1,2,3-tricarboxílico. Ácido natural del sustrato fermentativo."@es;
    rdfs:label "Citric acid"@en, "Ácido cítrico"@es;
    rdfs:seeAlso obo:CHEBI_30769 .
  
  :OrganicAcid rdfs:comment "Clase padre de los ácidos producidos durante la fermentación."@es;
    rdfs:label "Organic acid"@en, "Ácido orgánico"@es;
    rdfs:seeAlso obo:CHEBI_64709 .
  
  :Ester rdfs:comment "Compuestos de esterificación entre ácidos y alcoholes. Responsables de aromas frutales."@es;
    rdfs:label "Ester"@en, "Éster"@es;
    rdfs:seeAlso obo:CHEBI_35701 .
  
  :Ethanol rdfs:comment "Alcohol etílico C2H5OH. Producto de la fermentación alcohólica de azúcares."@es;
    rdfs:label "Ethanol"@en, "Etanol"@es;
    rdfs:seeAlso obo:CHEBI_16236 .
  
  :FilamentousFungus rdfs:comment "Hongos eucarióticos filamentosos distintos de levaduras. Pueden generar defectos sensoriales."@es;
    rdfs:label "Filamentous fungus"@en, "Hongo filamentoso"@es;
    rdfs:seeAlso obo:NCBITaxon_4751 .
  
  :Microorganism rdfs:comment "Clase raíz de todos los microorganismos que participan en el bioproceso de fermentación."@es;
    rdfs:label "Microorganism"@en, "Microorganismo"@es .
  
  :Fructose rdfs:comment "Monosacárido consumido por microorganismos fermentadores."@es;
    rdfs:label "Fructose"@en, "Fructosa"@es;
    rdfs:seeAlso obo:CHEBI_15824 .
  
  :SimpleSugar rdfs:comment "Azúcares simples del sustrato fermentativo, que agrupan monosacáridos (glucosa, fructosa) y disacáridos (sacarosa). Constituyen los sustratos primarios consumidos por los microorganismos durante la fermentación."@es;
    rdfs:label "Simple sugar"@en, "Azúcar simple"@es;
    rdfs:seeAlso obo:CHEBI_16646 .
  
  :Glucose rdfs:comment "Monosacárido. Principal azúcar consumido por microorganismos durante la fermentación."@es;
    rdfs:label "Glucose"@en, "Glucosa"@es;
    rdfs:seeAlso obo:CHEBI_17234 .
  
  :LacticAcid rdfs:comment "Principal producto de la fermentación láctica."@es;
    rdfs:label "Lactic acid"@en, "Ácido láctico"@es;
    rdfs:seeAlso obo:CHEBI_28358 .
  
  :MalicAcid rdfs:comment "Ácido hidroxibutanodioico. Componente del perfil de acidez del producto."@es;
    rdfs:label "Malic acid"@en, "Ácido málico"@es;
    rdfs:seeAlso obo:CHEBI_6650 .
  
  :ProcessingMethod rdfs:comment "Método de preparación del sustrato antes o durante la fermentación."@es;
    rdfs:label "Processing method"@en, "Método de procesamiento"@es .
  
  :SuccinicAcid rdfs:comment "Ácido butanodioico. Metabolito producido durante la fermentación."@es;
    rdfs:label "Succinic acid"@en, "Ácido succínico"@es;
    rdfs:seeAlso obo:CHEBI_15741 .
  
  :Sucrose rdfs:comment "Disacárido. Precursor de glucosa y fructosa. Principal azúcar de reserva del sustrato."@es;
    rdfs:label "Sucrose"@en, "Sacarosa"@es;
    rdfs:seeAlso obo:CHEBI_17992 .
  
  :WinyDefect rdfs:comment "Sabor a vino o vinagre por exceso de ácido acético en el producto fermentado."@es;
    rdfs:label "Winy defect"@en, "Defecto avinado"@es .
  
  :SensoryDefect rdfs:comment "Sabor indeseable detectable en la evaluación sensorial."@es;
    rdfs:label "Sensory defect"@en, "Defecto sensorial"@es .
  
  :hasAgitationSpeed rdfs:comment "Velocidad de agitación mecánica del biorreactor expresada en rpm."@es;
    rdfs:label "Has agitation speed"@en, "Velocidad de agitación"@es;
    rdfs:seeAlso sosa:ObservableProperty, obo:PREFER_0000054 .
  
  :Bioreactor rdfs:comment "Instrumento físico donde ocurre el bioproceso de fermentación. Objeto de interés observado por los sensores del sistema."@es;
    rdfs:label "Bioreactor"@en, "Biorreactor"@es;
    rdfs:seeAlso sosa:FeatureOfInterest, saref:Device, s4inma:ProductionEquipment, obo:PREFER_0000014 .
  
  :hasAirFlow rdfs:comment "Flujo de aire suministrado al biorreactor"@es;
    rdfs:label "Has air flow"@en, "Flujo de aireación"@es;
    rdfs:seeAlso sosa:ObservableProperty, obo:PREFER_0000055 .
  
  :hasAltitude rdfs:comment "Altura sobre el nivel del mar donde se ubica el biorreactor. En metros."@es;
    rdfs:label "Has altitude"@en, "Altitud"@es;
    rdfs:seeAlso quantitykind:Altitude .
  
  :hasAmbientHumidity rdfs:comment "Humedad relativa del ambiente externo al biorreactor expresada en porcentaje."@es;
    rdfs:label "Has ambient humidity"@en, "Humedad del ambiente"@es;
    rdfs:seeAlso sosa:ObservableProperty .
  
  :hasAmbientTemperature rdfs:comment "Temperatura del entorno externo al biorreactor."@es;
    rdfs:label "Has ambient temperature"@en, "Temperatura ambiente"@es;
    rdfs:seeAlso sosa:ObservableProperty .
  
  :hasBrixDegree rdfs:comment "Sólidos solubles totales del sustrato. Indicador de azúcares disponibles para fermentación."@es;
    rdfs:label "Has Brix degree"@en, "Grados Brix"@es;
    rdfs:seeAlso sosa:ObservableProperty .
  
  :hasConcentration rdfs:comment "Concentración de un compuesto químico en el medio fermentativo expresada en g/L."@es;
    rdfs:label "Has concentration"@en, "Concentración"@es;
    rdfs:seeAlso quantitykind:Concentration .
  
  :hasDissolvedOxygen rdfs:comment "Concentración de oxígeno en solución."@es;
    rdfs:label "Has dissolved oxygen"@en, "Oxígeno disuelto (DO)"@es;
    rdfs:seeAlso sosa:ObservableProperty, obo:PREFER_0000039 .
  
  :hasFermentationDuration rdfs:comment "Duración total del proceso fermentativo expresada en horas."@es;
    rdfs:label "Has fermentation duration"@en, "Duración de fermentación"@es;
    rdfs:seeAlso quantitykind:Time .
  
  :hasFermentationTemperature rdfs:comment "Temperatura dentro de la masa fermentativa. Sensor DS18B20 disponible en el biorreactor."@es;
    rdfs:label "Has fermentation temperature"@en, "Temperatura de fermentación"@es;
    rdfs:seeAlso sosa:ObservableProperty, obo:PREFER_0000041 .
  
  :hasMeasuredActivity rdfs:comment "Actividad enzimática específica expresada en unidades por mililitro."@es;
    rdfs:label "Has measured activity"@en, "Actividad enzimática medida"@es;
    rdfs:seeAlso sosa:ObservableProperty .
  
  :hasMeasuredValue rdfs:comment "Valor numérico medido por sensor en un momento específico del proceso."@es;
    rdfs:label "Has measured value"@en, "Valor medido"@es;
    rdfs:seeAlso saref:Measurement, sosa:hasSimpleResult .
  
  :hasMicrobialConcentration rdfs:comment "Concentración de microorganismos expresada en unidades formadoras de colonia por mililitro."@es;
    rdfs:label "Has microbial concentration"@en, "Concentración microbiana"@es;
    rdfs:seeAlso sosa:ObservableProperty .
  
  :hasObservation rdfs:comment "Vincula el biorreactor con las observaciones registradas por los sensores del sistema."@es;
    rdfs:label "Has observation"@en, "Tiene observación"@es;
    rdfs:seeAlso saref:Observation, sosa:Observation .
  
  :hasOptimalRangeMax rdfs:comment "Límite superior del rango óptimo de la variable en el proceso de fermentación."@es;
    rdfs:label "Has optimal range maximum"@en, "Rango óptimo máximo"@es;
    rdfs:seeAlso sosa:ObservableProperty .
  
  :hasOptimalRangeMin rdfs:comment "Límite inferior del rango óptimo de la variable en el proceso de fermentación."@es;
    rdfs:label "Has optimal range minimum"@en, "Rango óptimo mínimo"@es;
    rdfs:seeAlso sosa:ObservableProperty .
  
  :hasPH rdfs:comment "Potencial de hidrógeno del medio fermentativo."@es;
    rdfs:label "Has pH"@en, "pH"@es;
    rdfs:seeAlso sosa:ObservableProperty, obo:PREFER_0000040 .
  
  :hasRedoxPotential rdfs:comment "Potencial de oxidorreducción del medio"@es;
    rdfs:label "Has redox potential"@en, "Potencial redox (ORP)"@es;
    rdfs:seeAlso sosa:ObservableProperty .
  
  :hasSubstrateHumidity rdfs:comment "Contenido de agua en el sustrato durante la fermentación expresado en porcentaje."@es;
    rdfs:label "Has substrate humidity"@en, "Humedad del sustrato"@es;
    rdfs:seeAlso sosa:ObservableProperty .
  
  :hasSubstrateVolume rdfs:comment "Volumen en litros del sustrato fermentativo en el biorreactor."@es;
    rdfs:label "Has substrate volume"@en, "Volumen del sustrato"@es;
    rdfs:seeAlso sosa:ObservableProperty .
  
  :hasTotalMicrobialPopulation rdfs:comment "Suma de UFC/mL de todos los microorganismos presentes en el proceso."@es;
    rdfs:label "Has total microbial population"@en, "Población microbiana total"@es;
    rdfs:seeAlso sosa:ObservableProperty .
  
  <https://w3id.org/bfpo> rdfs:comment "Bioreactor Fermentation Process Ontology - Ontología del bioproceso de fermentación en biorreactor"@es;
    owl:priorVersion <https://w3id.org/bfpo/1.2>;
    owl:versionInfo "1.3";
    owl:versionIRI <https://w3id.org/bfpo/1.3>;
    dc:creator "Karen Viviana Muñoz Portilla";
    dc:date "2026-11";
    dc:description "Ontología de dominio que formaliza el conocimiento del bioproceso de fermentación en biorreactor. Desarrollada como parte del proyecto CDT+KG en la Universidad del Cauca. Caso de uso: fermentación de café de especialidad."@es;
    dc:language "es";
    dc:publisher "Universidad del Cauca";
    dc:rights "CC BY 4.0";
    dc:title "Bioreactor Fermentation Process Ontology";
    mod:acronym "BFPO";
    mod:formalityLevel "OWL 2 DL";
    mod:naturalLanguage "es (etiquetas) , en (identificadores técnicos)";
    mod:noOfClasses "75";
    mod:noOfProperties 87;
    mod:ontologyType "Domain Ontology";
    mod:status "stable" .
  
  :AceticAcid rdfs:comment "Ácido etanoico. Indicador de sobrefermentación cuando excede el umbral."@es;
    rdfs:label "Acetic acid"@en, "Ácido acético"@es;
    rdfs:seeAlso obo:CHEBI_15366 .
  
  :AceticDefect rdfs:comment "Sabor a vinagre por producción excesiva de ácido acético durante la fermentación."@es;
    rdfs:label "Acetic defect"@en, "Defecto acético"@es .
  
  :Aroma rdfs:comment "Percepción aromática del producto fermentado evaluada en el protocolo SCA."@es;
    rdfs:label "Aroma"@en, "Aroma"@es;
    rdfs:seeAlso obo:PATO_0000058 .
  
  :SensoryAttribute rdfs:comment "Clase raíz de todos los atributos evaluados en el análisis sensorial del producto fermentado según el protocolo SCA Cupping 2015."@es;
    rdfs:label "Sensory attribute"@en, "Atributo sensorial"@es;
    rdfs:seeAlso obo:PATO_0000001 .
  
  :Balance rdfs:comment <https://w3id.org/bfpo>;
    rdfs:label "Balance"@en, "Balance"@es .
  
  :CaramelNote rdfs:comment "Notas de caramelo, miel y panela en el perfil aromático."@es;
    rdfs:label "Caramel note"@en, "Nota caramelo"@es .
  
  :AromaticNote rdfs:comment "Clase raíz de todas las notas específicas del perfil organoléptico del producto fermentado según el SCA Flavor Wheel 2016."@es;
    rdfs:label "Aromatic note"@en, "Nota aromática"@es;
    rdfs:seeAlso obo:PATO_0000058 .
  
  :CarbonicMaceration rdfs:comment "Fermentación con CO2 exógeno. Término enológico adoptado en café de especialidad."@es;
    rdfs:label "Carbonic maceration"@en, "Maceración carbónica"@es .
  
  :AnaerobicFermentationType rdfs:comment "Clasificación de fermentaciones sin oxígeno."@es;
    rdfs:label "Anaerobic fermentation type"@en, "Tipo de fermentación anaeróbica"@es .
  
  :CupClarity rdfs:comment "Ausencia de sabores extraños o defectos en el producto evaluado."@es;
    rdfs:label "Cup clarity"@en, "Limpieza de taza"@es .
  
  :Flavor rdfs:comment "Percepción gustativa integrada. Incluye componentes gustativos y retronasal."@es;
    rdfs:label "Flavor"@en, "Sabor"@es;
    rdfs:seeAlso obo:PATO_0000043 .
  
  :HerbalNote rdfs:comment "Notas herbales de té y plantas en el perfil aromático."@es;
    rdfs:label "Herbal note"@en, "Nota herbal"@es .
  
  :MediumQuality rdfs:comment "Puntaje SCA entre 80 y 84,99, según el protocolo de catación de la SCA."@es;
    rdfs:label "Medium quality"@en, "Calidad media"@es .
  
  :QualityClassification rdfs:comment "Sistema de categorización del producto fermentado por rango de puntaje SCA."@es;
    rdfs:label "Quality classification"@en, "Clasificación de calidad"@es;
    owl:priorVersion :QualityClassification .
  
  :NuttyNote rdfs:comment "Notas de nueces y almendras en el perfil aromático."@es;
    rdfs:label "Nutty note"@en, "Nota frutos secos"@es .
  
  :OpenSystem rdfs:comment "Sistema de fermentación en contacto con el ambiente. Permite intercambio de O2 y CO2."@es;
    rdfs:label "Open system"@en, "Sistema abierto"@es .
  
  :FermentationSystemConfiguration rdfs:comment "Tipo de sistema de fermentación por grado de apertura. Determina disponibilidad de oxígeno en el proceso."@es;
    rdfs:label "Fermentation system configuration"@en, "Configuración del sistema"@es .
  
  :OverfermentedDefect rdfs:comment "Defecto causado por tiempo o temperatura de fermentación excesivos."@es;
    rdfs:label "Overfermented defect"@en, "Defecto de sobrefermentación"@es .
  
  :OverripeState rdfs:comment "Sustrato pasado del punto óptimo. Riesgo de defectos por fermentación previa al proceso."@es;
    rdfs:label "Overripe state"@en, "Estado sobremaduro"@es .
  
  :RipenessState rdfs:comment "Nivel de madurez del sustrato al inicio del proceso. Determina la composición química inicial."@es;
    rdfs:label "Ripeness state"@en, "Estado de madurez"@es;
    rdfs:seeAlso obo:PATO_0000001 .
  
  :RipeState rdfs:comment "Sustrato en punto óptimo de madurez. Mayor contenido de azúcares y aromas precursores."@es;
    rdfs:label "Ripe state"@en, "Estado maduro"@es;
    rdfs:seeAlso obo:PATO_0001701 .
  
  :SensoryAnalysis rdfs:comment "Evaluación sensorial formal del producto fermentado mediante el protocolo SCA de catación."@es;
    rdfs:label "Sensory analysis"@en, "Análisis sensorial"@es .
  
  :QualityEvaluation rdfs:comment "Proceso formal de valoración de calidad del producto fermentado."@es;
    rdfs:label "Quality evaluation"@en, "Evaluación de calidad"@es .
  
  :SolidStateFermentation rdfs:comment "Fermentación sin agua añadida. Menor actividad de agua y proceso más lento."@es;
    rdfs:label "Solid state fermentation"@en, "Fermentación en estado sólido"@es .
  
  :FermentationMediumType rdfs:comment "Clasificación por presencia o ausencia de agua en el medio fermentativo."@es;
    rdfs:label "Fermentation medium type"@en, "Tipo de medio de fermentación"@es;
    rdfs:seeAlso obo:PREFER_0000011 .
  
  :SpicyNote rdfs:comment "Notas de especias en el perfil aromático. Canela, clavo, pimienta."@es;
    rdfs:label "Spicy note"@en, "Nota especiada"@es .
  
  :StandardAnaerobicFermentation rdfs:comment "Fermentación en tanques sellados sin O2. Sin modificaciones adicionales al proceso anaeróbico."@es;
    rdfs:label "Standard anaerobic fermentation"@en, "Fermentación anaeróbica estándar"@es .
  
  :StandardQuality rdfs:comment "Puntaje SCA menor a 80, según el protocolo de catación de la SCA."@es;
    rdfs:label "Standard quality"@en, "Calidad estándar"@es .
  
  :SubmergedFermentation rdfs:comment "ermentación con sustrato bajo agua. Garantiza anaerobiosis total desde el inicio del proceso."@es;
    rdfs:label "Submerged fermentation"@en, "Fermentación sumergida"@es .
  
  :Sweetness rdfs:comment "Percepción de dulzura natural del producto. Distinto del contenido de azúcares residuales."@es;
    rdfs:label "Sweetness"@en, "Dulzor"@es .
  
  :Uniformity rdfs:comment "Consistencia percibida entre múltiples tazas del mismo lote evaluado."@es;
    rdfs:label "Uniformity"@en, "Uniformidad"@es .
  
  :UnripeState rdfs:comment "Sustrato inmaduro. Menor contenido de azúcares y compuestos precursores aromáticos"@es;
    rdfs:label "Unripe state"@en, "Estado verde"@es;
    rdfs:seeAlso obo:PATO_0001501 .
  
  :WinyNote rdfs:comment :WinyNote, "Notas fermentadas con carácter vinoso en el perfil aromático."@es;
    rdfs:label "Winy note"@en, "Nota vinosa"@es .
  
  :Yeast rdfs:comment "Hongos unicelulares fermentadores. Producen etanol, CO2 y compuestos volátiles."@es;
    rdfs:label "Yeast"@en, "Levadura"@es;
    rdfs:seeAlso obo:NCBITaxon_147537 .
  
  :conditions rdfs:comment "Relación de condicionamiento entre dos conceptos del bioproceso."@es;
    rdfs:label "Conditions"@en, "Condiciona"@es .
  
  :hasAcidityQuality rdfs:comment "Calidad percibida de la acidez del producto."@es;
    rdfs:label "Has acidity quality"@en, "Calidad de acidez"@es .
  
  :SensoryAcidity rdfs:comment "Percepción vibrante de acidez en taza. Distinta del pH que es una medición química."@es;
    rdfs:label "Sensory acidity"@en, "Acidez sensorial"@es .
  
  :hasAftertasteDuration rdfs:comment "Duración del sabor residual post-deglución."@es;
    rdfs:label "Has aftertaste duration"@en, "Duración del retrogusto"@es .
  
  :Aftertaste rdfs:comment "Sabor residual percibido después de deglutir el producto evaluado."@es;
    rdfs:label "Aftertaste"@en, "Retrogusto"@es .
  
  :hasAftertasteQuality rdfs:comment "Calidad del retrogusto percibido."@es;
    rdfs:label "Has aftertaste quality"@en, "Calidad del retrogusto"@es .
  
  :hasAgitationFrequency rdfs:comment "Descripción de la frecuencia de agitación aplicada al biorreactor."@es;
    rdfs:label "Has agitation frequency"@en, "Frecuencia de agitación"@es .
  
  :hasAgitationType rdfs:comment "Patrón de agitación del biorreactor."@es;
    rdfs:label "Has agitation type"@en, "Tipo de agitación"@es .
  
  :hasAnaerobicThreshold rdfs:comment "Valor de oxígeno disuelto por debajo del cual se considera condición anaeróbica."@es;
    rdfs:label "Has anaerobic threshold"@en, "Umbral anaeróbico"@es .
  
  :hasAromaticIntensity rdfs:comment "Fuerza del perfil aromático percibido en el producto."@es;
    rdfs:label "Has aromatic intensity"@en, "Intensidad aromática"@es .
  
  :AromaticProfile rdfs:comment "Conjunto integrado de aromas percibidos en el producto fermentado."@es;
    rdfs:label "Aromatic profile"@en, "Perfil aromático"@es .
  
  :hasBalanceQuality rdfs:comment "Calidad de la armonía entre los atributos sensoriales."@es;
    rdfs:label "Has balance quality"@en, "Calidad del balance"@es .
  
  :hasBitternessQuality rdfs:comment "Calidad del amargor percibido en el producto."@es;
    rdfs:label "Has bitterness quality"@en, "Calidad del amargor"@es .
  
  :Bitterness rdfs:comment "Percepción amarga asociada a compuestos fenólicos y alcaloides del producto."@es;
    rdfs:label "Bitterness"@en, "Amargor"@es;
    rdfs:seeAlso obo:PATO_0002474 .
  
  :hasChocolateType rdfs:comment "Subcategoría de la nota chocolate."@es;
    rdfs:label "Has chocolate type"@en, "Tipo de nota chocolate"@es .
  
  :ChocolateNote rdfs:comment "Notas de chocolate y cacao en el perfil aromático."@es;
    rdfs:label "Chocolate note"@en, "Nota chocolate"@es .
  
  :hasCupProfile rdfs:comment "Conjunto de características organolépticas del producto evaluado en taza."@es;
    rdfs:label "Has cup profile"@en, "Perfil en taza"@es .
  
  :hasDefectIntensity rdfs:comment "Intensidad del defecto sensorial detectado."@es;
    rdfs:label "Has defect intensity"@en, "Intensidad del defecto"@es .
  
  :hasDefectPresence rdfs:comment "ndica si un defecto sensorial específico está presente en el producto evaluado."@es;
    rdfs:label "Has defect presence"@en, "Presencia de defecto"@es .
  
  :hasDefectThreshold rdfs:comment "Nivel crítico de concentración de ácido acético a partir del cual se genera defecto avinado."@es;
    rdfs:label "Has defect threshold"@en, "Umbral de defecto"@es .
  
  :hasDominantAcidType rdfs:comment "Tipo de ácido que domina la percepción de acidez."@es;
    rdfs:label "Has dominant acid type"@en, "Tipo de ácido predominante"@es .
  
  :hasDryBeansRatio rdfs:comment "Porcentaje de sustrato sin defectos físicos visibles."@es;
    rdfs:label "Has dry beans ratio"@en, "Proporción de granos secos"@es .
  
  :hasDryMatterContent rdfs:comment "Porcentaje de sólidos totales en el sustrato fermentativo."@es;
    rdfs:label "Has dry matter content"@en, "Contenido de materia seca"@es .
  
  :hasEnzymeType rdfs:comment "Tipo de enzima producida por microorganismos durante el proceso."@es;
    rdfs:label "Has enzyme type"@en, "Tipo de enzima"@es .
  
  :hasFermentativeCapacity rdfs:comment "Indica si la levadura produce etanol y CO2 durante la fermentación."@es;
    rdfs:label "Has fermentative capacity"@en, "Capacidad fermentativa"@es .
  
  :hasFinalMoistureContent rdfs:comment "Humedad del sustrato al finalizar la fermentación y antes del secado."@es;
    rdfs:label "Has final moisture content"@en, "Porcentaje de humedad final"@es .
  
  :hasFlavorNoteDevelopment rdfs:comment "Aparición y evolución de características aromáticas específicas durante la fermentación."@es;
    rdfs:label "Has flavor note development"@en, "Desarrollo de notas"@es .
  
  :hasFlowerType rdfs:comment "Subcategoría de la nota floral."@es;
    rdfs:label "Has flower type"@en, "Tipo de nota floral"@es .
  
  :FloralNote rdfs:comment "Notas florales en el perfil aromático. Jazmín, rosa, lavanda."@es;
    rdfs:label "Floral note"@en, "Nota floral"@es .
  
  :hasFruitType rdfs:comment "Subcategoría de la nota frutal."@es;
    rdfs:label "Has fruit type"@en, "Tipo de nota frutal"@es .
  
  :FruityNote rdfs:comment "Notas de frutas en el perfil aromático."@es;
    rdfs:label "Fruity note"@en, "Nota frutal"@es .
  
  :hasGramType rdfs:comment "Clasificación bacteriana por tinción de Gram."@es;
    rdfs:label "Has Gram type"@en, "Tipo Gram"@es .
  
  :Bacterium rdfs:comment "Microorganismos procarióticos del bioproceso."@es;
    rdfs:label "Bacterium"@en, "Bacteria"@es;
    rdfs:seeAlso obo:NCBITaxon_2 .
  
  :hasInitialState rdfs:comment "Estado del sustrato al inicio del proceso."@es;
    rdfs:label "Has initial state"@en, "Estado inicial del sustrato"@es .
  
  :hasMaxScore rdfs:comment "Puntaje máximo de la categoría de calidad en la escala SCA."@es;
    rdfs:label "Has maximum score"@en, "Puntaje máximo del rango"@es .
  
  :hasMinScore rdfs:comment "Puntaje mínimo de la categoría de calidad en la escala SCA."@es;
    rdfs:label "Has minimum score"@en, "Puntaje mínimo del rango"@es .
  
  :hasMinimumRequiredScore rdfs:comment "Puntaje mínimo para clasificar un producto como alta calidad según el protocolo SCA."@es;
    rdfs:label "Has minimum required score"@en, "Puntaje mínimo requerido"@es .
  
  :HighQuality rdfs:comment "Puntaje SCA igual o mayor a 85, según el protocolo de catación de la SCA."@es;
    rdfs:label "High quality"@en, "Alta calidad"@es .
  
  :hasMucilagePercentage rdfs:comment "Porcentaje de mucílago retenido en el sustrato al inicio del proceso."@es;
    rdfs:label "Has mucilage percentage"@en, "Porcentaje de mucílago"@es .
  
  :hasNoteCount rdfs:comment "Número de notas aromáticas identificadas en el perfil del producto evaluado."@es;
    rdfs:label "Has note count"@en, "Cantidad de notas aromáticas"@es .
  
  :AromaticComplexity rdfs:comment "Diversidad de notas aromáticas perceptibles simultáneamente en el producto evaluado."@es;
    rdfs:label "Aromatic complexity"@en, "Complejidad aromática"@es;
    rdfs:seeAlso obo:PATO_0001502 .
  
  :hasNoteIntensity rdfs:comment "Intensidad de una nota aromática específica."@es;
    rdfs:label "Has note intensity"@en, "Intensidad de nota"@es .
  
  :hasNotePresence rdfs:comment "Indica si una nota aromática específica está presente en el perfil del producto."@es;
    rdfs:label "Has note presence"@en, "Presencia de nota"@es .
  
  :hasOptimalPH rdfs:comment "pH óptimo de crecimiento de la especie microbiológica."@es;
    rdfs:label "Has optimal pH"@en, "pH óptimo"@es .
  
  :hasOptimalTemperature rdfs:comment "Temperatura óptima de crecimiento de la especie microbiológica."@es;
    rdfs:label "Has optimal temperature"@en, "Temperatura óptima"@es .
  
  :hasOrganicAcidProfile rdfs:comment "Análisis completo de ácidos orgánicos presentes en el producto final de la fermentación."@es;
    rdfs:label "Has organic acid profile"@en, "Perfil de ácidos orgánicos"@es;
    rdfs:seeAlso obo:PREFER_0000074 .
  
  :hasOxygenTolerance rdfs:comment "Requerimiento de oxígeno para el crecimiento."@es;
    rdfs:label "Has oxygen tolerance"@en, "Tolerancia al oxígeno"@es .
  
  :hasPart rdfs:comment "Indica que un concepto contiene a otro como componente."@es;
    rdfs:label "Has part"@en, "Tiene como parte"@es;
    rdfs:seeAlso prov:hadMember .
  
  :isPartOf rdfs:comment "Relación mereológica. Indica que un concepto es componente de otro."@es;
    rdfs:label "Is part of"@en, "Es parte de"@es;
    rdfs:seeAlso prov:hadMember .
  
  :hasPerceivedIntensity rdfs:comment "Intensidad de percepción de un atributo sensorial."@es;
    rdfs:label "Has perceived intensity"@en, "Intensidad percibida"@es .
  
  :hasPerceivedWeight rdfs:comment "Sensación de peso del producto en boca."@es;
    rdfs:label "Has perceived weight"@en, "Peso percibido"@es .
  
  :Body rdfs:comment "Sensación táctil de peso y textura del producto fermentado en boca."@es;
    rdfs:label "Body"@en, "Cuerpo"@es;
    rdfs:seeAlso obo:PATO_0000037 .
  
  :hasProbableCause rdfs:comment "Causa probable del defecto sensorial identificado en la evaluación."@es;
    rdfs:label "Has probable cause"@en, "Causa probable"@es .
  
  :hasQualityClassification rdfs:comment "Vincula el puntaje SCA con su categoría de calidad correspondiente."@es;
    rdfs:label "Has quality classification"@en, "Tiene clasificación de calidad"@es .
  
  :SCAScore rdfs:comment "Puntuación total SCA en escala 0-100."@es;
    rdfs:label "SCA score"@en, "Puntaje SCA"@es .
  
  :hasResidualSugarContent rdfs:comment "Azúcares no consumidos por los microorganismos al finalizar la fermentación"@es;
    rdfs:label "Has residual sugar content"@en, "Contenido de azúcares residuales"@es;
    rdfs:seeAlso obo:PREFER_0000111 .
  
  :hasRipenessLevel rdfs:comment "Estado de maduración del sustrato al inicio del proceso."@es;
    rdfs:label "Has ripeness level"@en, "Nivel de madurez"@es .
  
  :hasSCAAttributeScore rdfs:comment "Puntaje individual de cada atributo sensorial en escala 0-10."@es;
    rdfs:label "Has SCA attribute score"@en, "Puntaje SCA por atributo"@es .
  
  :hasSCAScore rdfs:comment "Puntuación total del protocolo SCA en escala 0-100."@es;
    rdfs:label "Has SCA score"@en, "Puntaje SCA total"@es .
  
  :hasSanitaryLevel rdfs:comment "Estado sanitario inicial del sustrato."@es;
    rdfs:label "Has sanitary level"@en, "Nivel sanitario inicial"@es .
  
  :hasScientificName rdfs:comment "Nombre científico binomial de la especie microbiológica según nomenclatura ICBN/ICNB."@es;
    rdfs:label "Has scientific name"@en, "Nombre científico"@es .
  
  :hasShannonIndex rdfs:comment "Índice de diversidad de especies microbianas presentes en el bioproceso."@es;
    rdfs:label "Has Shannon index"@en, "Índice de diversidad Shannon"@es .
  
  :hasSpecies rdfs:comment "Especie botánica de la variedad del sustrato.";
    rdfs:label "Has species"@en, "Especie"@es .
  
  :Variety rdfs:comment "Variedad botánica del sustrato procesado en la fermentación."@es;
    rdfs:label "Variety"@en, "Variedad del sustrato"@es .
  
  :hasSpiceType rdfs:comment "Subcategoría de la nota especiada."@es;
    rdfs:label "Has spice type"@en, "Tipo de nota especiada"@es .
  
  :hasTexture rdfs:comment "Textura percibida del producto en boca."@es;
    rdfs:label "Has texture"@en, "Textura"@es .
  
  :hasTotalTritrableAcidity rdfs:comment "Acidez acumulada en el producto fermentado."@es;
    rdfs:label "Has total titratable acidity"@en, "Acidez total y titulable"@es .
  
  :hasVarietyName rdfs:comment "Nombre de la variedad botánica del sustrato procesado en la fermentación."@es;
    rdfs:label "Has variety name"@en, "Nombre de variedad"@es .
  
  :hosts rdfs:comment "Vincula el biorreactor con la configuración del proceso que aloja."@es;
    rdfs:label "Hosts"@en, "Aloja proceso"@es .
  
  :influences rdfs:comment "Relación general de influencia o dependencia documentada entre conceptos del bioproceso. Puede representar una relación directa o una dependencia indirecta inferida; no especifica el sentido de la variación ni demuestra por sí sola causalidad biológica."@es;
    rdfs:label "Influences"@en, "Influye en"@es .
  
  :meetsCriteria rdfs:comment "Indica si el producto cumple el criterio de alta calidad según el protocolo SCA."@es;
    rdfs:label "Meets criteria"@en, "Cumple criterio"@es .
  
  :participatesIn rdfs:comment "Indica que un microorganismo participa activamente en el bioproceso de fermentación."@es;
    rdfs:label "Participates in"@en, "Participa en"@es .
  
  :producedBy rdfs:comment "Indica qué microorganismo produce un compuesto químico durante el bioproceso."@es;
    rdfs:label "Produced by"@en, "Producido por"@es .
  
  :wasGeneratedBy rdfs:comment "Trazabilidad del compuesto químico. Indica en qué biorreactor fue generado."@es;
    rdfs:label "Was generated by"@en, "Fue generado por"@es;
    rdfs:seeAlso prov:wasGeneratedBy .
  
  :ClosedSystem rdfs:comment "istema sellado sin contacto con el ambiente. Acumula CO2."@es;
    rdfs:label "Closed system"@en, "Sistema cerrado"@es .
  
  :QualityDescriptor rdfs:comment "Agrupa descriptores cualitativos positivos y defectos sensoriales del producto fermentado evaluado."@es;
    rdfs:label "Quality descriptor"@en, "Descriptor de calidad"@es;
    rdfs:seeAlso obo:PATO_0000001 .
  
  :positivelyInfluences rdfs:comment "Relación de influencia directa: dentro de las condiciones documentadas, un aumento del sujeto se asocia con un aumento del objeto y una disminución del sujeto con una disminución del objeto. No expresa beneficio ni calidad favorable."@es;
    rdfs:label "Influye positivamente en"@es, "positively influences"@en .
  
  :negativelyInfluences rdfs:comment "Relación de influencia inversa: dentro de las condiciones documentadas, un aumento del sujeto se asocia con una disminución del objeto y una disminución del sujeto con un aumento del objeto. No expresa perjuicio ni deterioro de calidad."@es;
    rdfs:label "Influye negativamente en"@es, "negatively influences"@en .
  
  :produces rdfs:comment "Relates a biological agent or process to a compound or product it generates during  fermentation. SubProperty of influences."@en;
    rdfs:label "Produce"@es, "produces"@en .
  
  :hasCriticalThresholdMax rdfs:comment """Maximum critical threshold for a process variable. Values above this threshold indicate a critical condition requiring operational intervention. 
Based on: Peñuela-Martínez et al. (2023), Cruz-O'Byrne et al. (2020)."""@en;
    rdfs:label "has critical threshold maximum"@en, "Umbral crítico máximo"@es;
    rdfs:isDefinedBy "https://w3id.org/bfpo#" .
  
  :hasCriticalThresholdMin rdfs:comment """Minimum critical threshold for a process variable. Values below this threshold indicate a critical condition requiring operational intervention. 
Based on: Cruz-O'Byrne et al. (2020), Ferreira et al. (2023), 
Peñuela-Martínez et al. (2023)."""@en;
    rdfs:label "has critical threshold minimum"@en, "Umbral crítico mínimo"@es;
    rdfs:isDefinedBy "https://w3id.org/bfpo#" .
  
  :ProcessVariable rdfs:comment """Measurable variable of the coffee fermentation process in a bioreactor. Each instance 
represents a specific variable with its associated optimal operational ranges and critical thresholds documented in the scientific literature."""@en;
    rdfs:label "Process Variable"@en, "Variable de proceso"@es;
    rdfs:seeAlso obo:PREFER_0000098 .
  
  :AlcoholVariable rdfs:comment "Ethanol concentration produced by yeast activity during coffee fermentation. High alcohol levels may inhibit microbial activity and affect sensory quality. Critical threshold based on Brioschi Junior et al. (2021)."@en;
    rdfs:label "Alcohol content"@en;
    :hasOptimalRangeMax "2.0"^^xsd:float;
    :hasOptimalRangeMin "0.0"^^xsd:float .
  
  :BrixVariable rdfs:comment "Soluble solids content of the fermentation medium expressed in degrees Brix. Indicator of substrate availability for microbial activity. Values based on Ferreira et al. (2023)."@en;
    rdfs:label "Brix degree"@en;
    :hasOptimalRangeMax "16.0"^^xsd:float;
    :hasOptimalRangeMin "9.0"^^xsd:float .
  
  :DissolvedOxygenVariable rdfs:comment "Dissolved oxygen concentration in the fermentation medium. In SIAF and anaerobic fermentation processes, oxygen decreases progressively as microbial  activity consumes it. Values below 0.5 mg/L indicate anaerobiosis. Based on Ferreira et al. (2023)."@en;
    rdfs:label "Dissolved oxygen"@en;
    :hasOptimalRangeMax "2.0"^^xsd:float;
    :hasOptimalRangeMin "0.0"^^xsd:float .
  
  :TemperatureVariable rdfs:comment """Temperature of the fermentation medium in the bioreactor. Controls microbial kinetics and enzymatic activity. Optimal range based on Peñuela-Martínez et al. (2023) and 
Cruz-O'Byrne et al. (2020) for controlled temperature coffee fermentation."""@en;
    rdfs:label "Fermentation temperature"@en;
    :hasOptimalRangeMax "25.0"^^xsd:float;
    :hasOptimalRangeMin "15.0"^^xsd:float .
  
  :TotalAcidityVariable rdfs:comment "Total titratable acidity of the fermentation medium expressed in g/L. Reflects the accumulation of organic acids produced by lactic acid bacteria and yeast during fermentation. Range based on Cruz-O'Byrne et al. (2020)"@en;
    rdfs:label "Total acidity"@en;
    :hasOptimalRangeMax "1.18"^^xsd:float;
    :hasOptimalRangeMin "0.45"^^xsd:float .
  
  :pHVariable rdfs:comment """Hydrogen ion concentration in the fermentation medium. Key indicator of microbial activity and fermentation progress in coffee bioreactor fermentation. Optimal range 
and critical threshold based on Cruz-O'Byrne et al. (2020) and Ferreira et al. (2023)."""@en;
    rdfs:label "pH"@en;
    :hasOptimalRangeMax "5.5"^^xsd:float;
    :hasOptimalRangeMin "4.0"^^xsd:float .
  
  :measuresVariable rdfs:comment "Relates a data property used to record an observation to the process variable it measures."@en;
    rdfs:label "measures variable"@en .
  
  :ProcessObservation rdfs:label "Process observation"@en, "Observación del proceso"@es .
}

<http://w3id.org/bfpo/conocimiento_experto> {
  :OrganicAcid rdfs:comment "Ácidos orgánicos producidos durante la fermentación. Su acumulación reduce el pH. Ref: Cruz-O'Byrne et al. (2020)."@es;
    rdfs:label "Organic acid"@en, "Ácido orgánico"@es .
  
  :Ester rdfs:comment "Compuestos aromáticos frutales formados por esterificación entre ácidos y alcoholes. Ref: Rocha et al. (2023)."@es;
    rdfs:label "Ester"@en, "Éster"@es .
  
  :Ethanol rdfs:comment "Alcohol etílico producido por levaduras durante la fermentación alcohólica. Precursor de compuestos aromáticos. Ref: Brioschi Junior et al. (2021)."@es;
    rdfs:label "Ethanol"@en, "Etanol"@es .
  
  :WinyDefect rdfs:comment "Defect characterized by wine-like fermented aroma. Caused by acetic acid accumulation and low pH. Ref: Ferreira et al. (2023), Brioschi Junior et al. (2021)."@en;
    rdfs:label "Winy defect"@en .
  
  :AceticDefect rdfs:comment "Defect characterized by vinegar-like aroma and flavor from excessive acetic acid production during prolonged fermentation. Ref: Cenicafé (2010), Cruz-O'Byrne et al. (2020)."@en;
    rdfs:label "Acetic defect"@en .
  
  :MediumQuality rdfs:comment "SCA entre 80 y 84 según protocolo SCA Cupping 2015."@es;
    rdfs:label "Medium quality"@en .
  
  :OverfermentedDefect rdfs:comment "Defect caused by excessive fermentation duration. Results in unpleasant odors and reduced cup quality. Ref: Cenicafé (2010)."@en;
    rdfs:label "Overfermented defect"@en .
  
  :StandardQuality rdfs:comment "SCA < 80 según protocolo SCA Cupping 2015."@es;
    rdfs:label "Standard quality"@en .
  
  :Yeast rdfs:comment "Levaduras fermentativas presentes en la fermentación de café. Géneros: Saccharomyces, Pichia, Candida. Ref: Revelo-Romo et al. (2025)."@es;
    rdfs:label "Yeast"@en, "Levadura"@es .
  
  :HighQuality rdfs:comment "SCA >= 85 según protocolo SCA Cupping 2015."@es;
    rdfs:label "High quality"@en .
  
  :LacticAcidBacteria rdfs:comment "Bacterias del ácido láctico (LAB) presentes en fermentaciones SIAF. Géneros: Leuconostoc, Lactobacillus. Ref: Revelo-Romo et al. (2025)."@es;
    rdfs:label "Lactic acid bacteria"@en, "Bacterias lácticas"@es .
  
  :CO2 rdfs:comment "CO2 producido por microorganismos. Indicador de actividad metabólica. En SIAF crea condiciones anaeróbicas."@es;
    rdfs:label "Carbon dioxide"@en, "Dióxido de carbono"@es .
  
  :AromaticIntensity rdfs:comment "Fuerza del perfil aromático percibido en el producto fermentado."@es;
    rdfs:label "Aromatic intensity"@en, "Intensidad aromática"@es .
  
  :VolatileCompound rdfs:label "Volatile compound"@en .
  
  :Microorganism rdfs:label "Microorganism"@en .
  
  :LacticAcid rdfs:label "Lactic acid"@en .
  
  :AceticAcid rdfs:label "Acetic acid"@en .
  
  :Aroma rdfs:label "Aroma"@en;
    :isPartOf :SCAScore .
  
  :Balance rdfs:label "Balance"@en;
    :isPartOf :SCAScore .
  
  :CupClarity rdfs:label "Cup clarity"@en;
    :isPartOf :SCAScore .
  
  :Flavor rdfs:label "Flavor"@en;
    :isPartOf :SCAScore .
  
  :Sweetness rdfs:label "Sweetness"@en;
    :isPartOf :SCAScore .
  
  :Uniformity rdfs:label "Uniformity"@en;
    :isPartOf :SCAScore .
  
  :SensoryAcidity rdfs:label "Sensory acidity"@en;
    :isPartOf :SCAScore .
  
  :Aftertaste rdfs:label "Aftertaste"@en;
    :isPartOf :SCAScore .
  
  :AromaticProfile rdfs:label "Aromatic profile"@en .
  
  :Body rdfs:label "Body"@en;
    :isPartOf :SCAScore .
  
  :SCAScore rdfs:label "SCA score"@en .
  
  :FermentationDuration rdfs:label "Fermentation duration"@en, "Duración de la fermentación"@es .
  
  :BrixDegree rdfs:label "Brix degree"@en, "Grados Brix"@es .
  
  :OrganicAcidProfile rdfs:label "Organic acid profile"@en, "Perfil de ácidos orgánicos"@es .
  
  :pH rdfs:label "pH"@en, "pH"@es .
  
  :FermentationTemperature rdfs:label "Fermentation temperature"@en, "Temperatura de fermentación"@es .
  
  :EthanolProduction rdfs:label "Ethanol production"@en, "Producción de etanol"@es .
  
  :SIAFFermentation rdfs:label "SIAF fermentation"@en, "Fermentación SIAF"@es .
}

{
  :influences rdfs:comment "Relación general de dependencia entre conceptos del bioproceso, directa o indirecta. No especifica el sentido de la variación ni implica causalidad demostrada."@es .
  
  :positivelyInfluences rdfs:comment "Relación directa: A y B varían en el mismo sentido dentro de las condiciones documentadas. No implica efecto favorable."@es .
  
  :negativelyInfluences rdfs:comment "Relación inversa: A y B varían en sentidos contrarios dentro de las condiciones documentadas. No implica efecto perjudicial."@es .
}

