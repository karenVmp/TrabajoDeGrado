# --- Clasificación de calidad ---
<#MapCalidad>
    rml:logicalSource <#FuenteCSV> ;
    rr:subjectMap [
        rr:template "https://w3id.org/bfpo#{quality_classification}" ;
        rr:class bfpo:QualityClassification
    ] ;
    rr:predicateObjectMap [
        rr:predicate rdfs:label ;
        rr:objectMap [ rml:reference "quality_classification" ; rr:datatype xsd:string ]
    ] .
